<?xml version="1.0"?>
<ScenContainer xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ScenTitle>Act of War, 1968</ScenTitle>
  <ScenDescription>&lt;BODY scroll=auto&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-ascii-font-family: Calibri; mso-fareast-font-family: "Times New Roman"; mso-hansi-font-family: Calibri; mso-bidi-font-family: Calibri; mso-fareast-language: EN-GB'&gt;&lt;FONT face=Calibri&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-ascii-font-family: Calibri; mso-fareast-font-family: "Times New Roman"; mso-hansi-font-family: Calibri; mso-bidi-font-family: Calibri; mso-fareast-language: EN-GB'&gt;&lt;FONT color=white&gt;&lt;B&gt;United States&amp;nbsp;vs. North Korea&lt;/B&gt; &lt;?xml:namespace prefix = "o" ns = "urn:schemas-microsoft-com:office:office" /&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/SPAN&gt;
&lt;P class=MsoNormal style="MARGIN: 0cm 0cm 0pt; LINE-HEIGHT: normal"&gt;&lt;FONT color=white&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-ascii-font-family: Calibri; mso-fareast-font-family: "Times New Roman"; mso-hansi-font-family: Calibri; mso-bidi-font-family: Calibri; mso-fareast-language: EN-GB'&gt;&amp;nbsp;&lt;/SPAN&gt;&lt;SPAN style='FONT-SIZE: 12pt; FONT-FAMILY: "Times New Roman",serif; mso-fareast-font-family: "Times New Roman"; mso-fareast-language: EN-GB'&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0cm 0cm 8pt; LINE-HEIGHT: normal; mso-margin-top-alt: auto; mso-margin-bottom-alt: auto"&gt;&lt;B&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-ascii-font-family: Calibri; mso-fareast-font-family: "Times New Roman"; mso-hansi-font-family: Calibri; mso-bidi-font-family: Calibri; mso-fareast-language: EN-GB'&gt;&lt;FONT color=white&gt;Date/Time:&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/B&gt;&lt;FONT color=white&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-ascii-font-family: Calibri; mso-fareast-font-family: "Times New Roman"; mso-hansi-font-family: Calibri; mso-bidi-font-family: Calibri; mso-fareast-language: EN-GB'&gt;&amp;nbsp;26&lt;SUP&gt;TH&lt;/SUP&gt; January, 1968/ 13:45:00 Zulu&lt;BR&gt;&lt;B&gt;Location:&lt;/B&gt; Wonsan – North Korea&lt;BR&gt;&lt;B&gt;Duration:&lt;/B&gt;&amp;nbsp;8 Hours&lt;BR&gt;&lt;B&gt;Playable Sides:&lt;/B&gt;&amp;nbsp;United States&lt;/SPAN&gt;&lt;SPAN style='FONT-SIZE: 12pt; FONT-FAMILY: "Times New Roman",serif; mso-fareast-font-family: "Times New Roman"; mso-fareast-language: EN-GB'&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0cm 0cm 0pt; LINE-HEIGHT: normal"&gt;&lt;FONT color=white&gt;&lt;B&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-ascii-font-family: Calibri; mso-fareast-font-family: "Times New Roman"; mso-hansi-font-family: Calibri; mso-bidi-font-family: Calibri; mso-fareast-language: EN-GB'&gt;Situation&lt;/SPAN&gt;&lt;/B&gt;&lt;SPAN style='FONT-SIZE: 12pt; FONT-FAMILY: "Times New Roman",serif; mso-fareast-font-family: "Times New Roman"; mso-fareast-language: EN-GB'&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0cm 0cm 0pt; LINE-HEIGHT: normal"&gt;&lt;SPAN style='FONT-SIZE: 12pt; FONT-FAMILY: "Times New Roman",serif; mso-fareast-font-family: "Times New Roman"; mso-fareast-language: EN-GB'&gt;&lt;FONT color=white&gt;&amp;nbsp;&lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0cm 0cm 0pt; LINE-HEIGHT: 16.5pt"&gt;&lt;SPAN style="FONT-SIZE: 12pt; mso-fareast-font-family: Arial; mso-bidi-font-family: Calibri; mso-fareast-language: EN-GB; mso-bidi-theme-font: minor-latin"&gt;&lt;FONT color=white&gt;On 23 January 1968 North Korean patrol boats supported by Mig-21’s captured the &lt;/FONT&gt;&lt;A title="USS Pueblo (AGER-2)" href="https://en.wikipedia.org/wiki/USS_Pueblo_(AGER-2)"&gt;&lt;SPAN style="TEXT-DECORATION: none; mso-color-alt: windowtext; text-underline: none"&gt;&lt;FONT color=white&gt;USS &lt;SPAN style="mso-bidi-font-style: italic"&gt;Pueblo&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/A&gt;&lt;FONT color=white&gt; northeast of the North Korean island of &lt;/FONT&gt;&lt;A title="Pansong archipelago" href="https://en.wikipedia.org/wiki/Pansong_archipelago"&gt;&lt;SPAN style="TEXT-DECORATION: none; mso-color-alt: windowtext; text-underline: none"&gt;&lt;FONT color=white&gt;Ung-do&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/A&gt;&lt;FONT color=white&gt;.&lt;SUP&gt;&lt;A href="https://en.wikipedia.org/wiki/Operation_Combat_Fox#cite_note-1"&gt;&lt;/A&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SUP&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0cm 0cm 0pt; LINE-HEIGHT: 16.5pt"&gt;&lt;SPAN style="FONT-SIZE: 12pt; mso-fareast-font-family: Arial; mso-bidi-font-family: Calibri; mso-fareast-language: EN-GB; mso-bidi-theme-font: minor-latin"&gt;&lt;FONT color=white&gt;The capture of the &lt;SPAN style="mso-bidi-font-style: italic"&gt;Pueblo&lt;/SPAN&gt; led to &lt;/FONT&gt;&lt;A title="Lyndon B. Johnson" href="https://en.wikipedia.org/wiki/Lyndon_B._Johnson"&gt;&lt;SPAN style="TEXT-DECORATION: none; mso-color-alt: windowtext; text-underline: none"&gt;&lt;FONT color=white&gt;President Lyndon Johnson&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/A&gt;&lt;FONT color=white&gt; ordering a &lt;/FONT&gt;&lt;A title="Show of force" href="https://en.wikipedia.org/wiki/Show_of_force"&gt;&lt;SPAN style="TEXT-DECORATION: none; mso-color-alt: windowtext; text-underline: none"&gt;&lt;FONT color=white&gt;show of force&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/A&gt;&lt;FONT color=white&gt; with a deployment of U.S. air and navy assets to Korea. &lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0cm 0cm 0pt; LINE-HEIGHT: 16.5pt"&gt;&lt;SPAN style="FONT-SIZE: 12pt; mso-fareast-font-family: Arial; mso-bidi-font-family: Calibri; mso-fareast-language: EN-GB; mso-bidi-theme-font: minor-latin"&gt;&lt;FONT color=white&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&amp;nbsp;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0cm 0cm 0pt; LINE-HEIGHT: 16.5pt"&gt;&lt;SPAN style="FONT-SIZE: 12pt; mso-fareast-font-family: Arial; mso-bidi-font-family: Calibri; mso-fareast-language: EN-GB; mso-bidi-theme-font: minor-latin"&gt;&lt;FONT color=white&gt;The airlift and deployment of 200+ aircraft was code named &lt;SPAN style="mso-bidi-font-style: italic; mso-bidi-font-weight: bold"&gt;Operation Combat Fox&lt;/SPAN&gt; while the deployment of six aircraft carriers plus support vessels was code named &lt;SPAN style="mso-bidi-font-style: italic"&gt;Operation Formation Star&lt;/SPAN&gt;. &lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0cm 0cm 0pt; LINE-HEIGHT: normal"&gt;&lt;SPAN style="FONT-SIZE: 12pt; mso-ascii-font-family: Calibri; mso-fareast-font-family: Arial; mso-hansi-font-family: Calibri; mso-bidi-font-family: Calibri; mso-fareast-language: EN-GB; mso-bidi-theme-font: minor-latin"&gt;&lt;o:p&gt;&lt;FONT color=white&gt;&amp;nbsp;&lt;/FONT&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0cm 0cm 0pt; LINE-HEIGHT: normal"&gt;&lt;FONT color=white&gt;&lt;SPAN style="FONT-SIZE: 12pt; mso-ascii-font-family: Calibri; mso-fareast-font-family: Arial; mso-hansi-font-family: Calibri; mso-bidi-font-family: Calibri; mso-fareast-language: EN-GB; mso-bidi-theme-font: minor-latin"&gt;Paul Bridge&lt;/SPAN&gt;&lt;SPAN style='FONT-SIZE: 12pt; FONT-FAMILY: "Times New Roman",serif; mso-fareast-font-family: "Times New Roman"; mso-fareast-language: EN-GB'&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0cm 0cm 0pt; LINE-HEIGHT: normal"&gt;&lt;SPAN style="FONT-SIZE: 12pt; mso-ascii-font-family: Calibri; mso-fareast-font-family: Arial; mso-hansi-font-family: Calibri; mso-bidi-font-family: Calibri; mso-fareast-language: EN-GB; mso-bidi-theme-font: minor-latin"&gt;&lt;FONT color=white&gt;Author and Scenario Designer&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0cm 0cm 0pt; LINE-HEIGHT: normal"&gt;&lt;SPAN style="FONT-SIZE: 12pt; mso-ascii-font-family: Calibri; mso-fareast-font-family: Arial; mso-hansi-font-family: Calibri; mso-bidi-font-family: Calibri; mso-fareast-language: EN-GB; mso-bidi-theme-font: minor-latin"&gt;&lt;FONT color=white&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&amp;nbsp;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0cm 0cm 0pt; LINE-HEIGHT: normal"&gt;&lt;SPAN style="FONT-SIZE: 12pt; mso-ascii-font-family: Calibri; mso-fareast-font-family: Arial; mso-hansi-font-family: Calibri; mso-bidi-font-family: Calibri; mso-fareast-language: EN-GB; mso-bidi-theme-font: minor-latin"&gt;&lt;EM&gt;&lt;FONT color=white&gt;Authors Note.&lt;/FONT&gt;&lt;/EM&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0cm 0cm 0pt; LINE-HEIGHT: normal"&gt;&lt;SPAN style="FONT-SIZE: 12pt; mso-ascii-font-family: Calibri; mso-fareast-font-family: Arial; mso-hansi-font-family: Calibri; mso-bidi-font-family: Calibri; mso-fareast-language: EN-GB; mso-bidi-theme-font: minor-latin"&gt;&lt;EM&gt;&lt;FONT color=white&gt;&lt;/FONT&gt;&lt;/EM&gt;&lt;/SPAN&gt;&amp;nbsp;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0cm 0cm 0pt; LINE-HEIGHT: normal"&gt;&lt;SPAN style="FONT-SIZE: 12pt; mso-ascii-font-family: Calibri; mso-fareast-font-family: Arial; mso-hansi-font-family: Calibri; mso-bidi-font-family: Calibri; mso-fareast-language: EN-GB; mso-bidi-theme-font: minor-latin"&gt;&lt;EM&gt;&lt;FONT color=white&gt;This scenario is based on one of the options which was the rescue of the crew and recovery of the USS Peublo by US Naval Forces.&lt;/FONT&gt;&lt;/EM&gt;&lt;/SPAN&gt;&lt;/P&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/BODY&gt;</ScenDescription>
