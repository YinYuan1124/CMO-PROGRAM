<?xml version="1.0"?>
<ScenContainer xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ScenTitle>A Hunting We Will Go, 1963</ScenTitle>
  <ScenDescription>&lt;BODY scroll=auto&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-ascii-font-family: Calibri; mso-fareast-font-family: "Times New Roman"; mso-hansi-font-family: Calibri; mso-bidi-font-family: Calibri; mso-fareast-language: EN-GB'&gt;&lt;FONT face=Calibri&gt;
&lt;P class=MsoNormal style="MARGIN: 0cm 0cm 0pt"&gt;&lt;STRONG&gt;NATO&amp;nbsp;vs. &lt;?xml:namespace prefix = "st1" ns = "urn:schemas-microsoft-com:office:smarttags" /&gt;&lt;st1:country-region w:st="on"&gt;&lt;st1:place w:st="on"&gt;Soviet Union&lt;/st1:place&gt;&lt;/st1:country-region&gt;&lt;/STRONG&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0cm 0cm 0pt"&gt;&lt;STRONG&gt;&lt;st1:country-region w:st="on"&gt;&lt;st1:place w:st="on"&gt;&lt;/st1:place&gt;&lt;/st1:country-region&gt;&lt;/STRONG&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;B&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-ascii-font-family: Calibri; mso-fareast-font-family: "Times New Roman"; mso-hansi-font-family: Calibri; mso-bidi-font-family: Calibri; mso-fareast-language: EN-GB'&gt;&lt;FONT face=Calibri&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/B&gt;&amp;nbsp;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0cm 0cm 8pt; LINE-HEIGHT: normal; mso-margin-top-alt: auto; mso-margin-bottom-alt: auto"&gt;&lt;B&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-ascii-font-family: Calibri; mso-fareast-font-family: "Times New Roman"; mso-hansi-font-family: Calibri; mso-bidi-font-family: Calibri; mso-fareast-language: EN-GB'&gt;&lt;FONT face=Calibri&gt;Date/Time:&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/B&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-ascii-font-family: Calibri; mso-fareast-font-family: "Times New Roman"; mso-hansi-font-family: Calibri; mso-bidi-font-family: Calibri; mso-fareast-language: EN-GB'&gt;&lt;FONT face=Calibri&gt;&amp;nbsp;3rd April, 1963/ 08:00:00 Zulu&lt;BR&gt;&lt;B&gt;Location:&lt;/B&gt; North Atlantic&lt;BR&gt;&lt;B&gt;Duration:&lt;/B&gt;&amp;nbsp;2 Days&lt;BR&gt;&lt;B&gt;Playable Sides:&lt;/B&gt;&amp;nbsp;NATO&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0cm 0cm 0pt; LINE-HEIGHT: normal"&gt;&lt;FONT face=Calibri&gt;&lt;B&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-ascii-font-family: Calibri; mso-fareast-font-family: "Times New Roman"; mso-hansi-font-family: Calibri; mso-bidi-font-family: Calibri; mso-fareast-language: EN-GB'&gt;Situation&lt;/SPAN&gt;&lt;/B&gt;&lt;/FONT&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0cm 0cm 0pt; LINE-HEIGHT: normal"&gt;&lt;FONT face=Calibri&gt;&lt;B&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-ascii-font-family: Calibri; mso-fareast-font-family: "Times New Roman"; mso-hansi-font-family: Calibri; mso-bidi-font-family: Calibri; mso-fareast-language: EN-GB'&gt;&lt;/SPAN&gt;&lt;/B&gt;&lt;/FONT&gt;&amp;nbsp;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0cm 0cm 0pt; LINE-HEIGHT: normal"&gt;&lt;FONT face=Calibri&gt;&lt;SPAN&gt;&lt;SPAN style="mso-fareast-font-family: Arial; mso-bidi-font-family: Calibri; mso-fareast-language: EN-GB; mso-bidi-theme-font: minor-latin"&gt;Early April 1963 and&lt;B style="mso-bidi-font-weight: normal"&gt; &lt;/B&gt;the Battle of the Atlantic is in full swing, Soviet Submarines have started to flood into the Atlantic trying to swamp NATO ASW assets in the process. &lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0cm 0cm 0pt; LINE-HEIGHT: normal"&gt;&lt;FONT face=Calibri&gt;&lt;SPAN&gt;&lt;SPAN style="mso-fareast-font-family: Arial; mso-bidi-font-family: Calibri; mso-fareast-language: EN-GB; mso-bidi-theme-font: minor-latin"&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&amp;nbsp;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0cm 0cm 0pt; LINE-HEIGHT: normal"&gt;&lt;FONT face=Calibri&gt;&lt;SPAN&gt;&lt;SPAN style="mso-fareast-font-family: Arial; mso-bidi-font-family: Calibri; mso-fareast-language: EN-GB; mso-bidi-theme-font: minor-latin"&gt;&lt;/SPAN&gt;&lt;SPAN style="mso-fareast-font-family: Arial; mso-bidi-font-family: Calibri; mso-fareast-language: EN-GB; mso-bidi-theme-font: minor-latin"&gt;Early action in the North Atlantic and the Norwegian Sea has been far more brutal than NATO had thought. with heavy losses on both sides.&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0cm 0cm 0pt; LINE-HEIGHT: normal"&gt;&lt;FONT face=Calibri&gt;&lt;SPAN&gt;&lt;SPAN style="mso-fareast-font-family: Arial; mso-bidi-font-family: Calibri; mso-fareast-language: EN-GB; mso-bidi-theme-font: minor-latin"&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&amp;nbsp;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0cm 0cm 0pt; LINE-HEIGHT: normal"&gt;&lt;FONT face=Calibri&gt;&lt;SPAN&gt;&lt;SPAN style="mso-fareast-font-family: Arial; mso-bidi-font-family: Calibri; mso-fareast-language: EN-GB; mso-bidi-theme-font: minor-latin"&gt;&lt;/SPAN&gt;&lt;SPAN style="mso-fareast-font-family: Arial; mso-bidi-font-family: Calibri; mso-fareast-language: EN-GB; mso-bidi-theme-font: minor-latin"&gt;NATO has put together several ASW Hunter Killer Groups from Canada, USA, UK and the Netherlands, these units should be able to stem the flow.&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0cm 0cm 0pt; LINE-HEIGHT: normal"&gt;&lt;FONT face=Calibri&gt;&lt;SPAN&gt;&lt;SPAN style="mso-fareast-font-family: Arial; mso-bidi-font-family: Calibri; mso-fareast-language: EN-GB; mso-bidi-theme-font: minor-latin"&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&amp;nbsp;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0cm 0cm 0pt; LINE-HEIGHT: normal"&gt;&lt;FONT face=Calibri&gt;&lt;SPAN&gt;&lt;SPAN style="mso-fareast-font-family: Arial; mso-bidi-font-family: Calibri; mso-fareast-language: EN-GB; mso-bidi-theme-font: minor-latin"&gt;&lt;SPAN&gt;&lt;SPAN style="mso-fareast-font-family: Arial; mso-bidi-font-family: Calibri; mso-fareast-language: EN-GB; mso-bidi-theme-font: minor-latin"&gt;Paul Bridge&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0cm 0cm 0pt; LINE-HEIGHT: normal"&gt;&lt;FONT face=Calibri&gt;&lt;SPAN&gt;&lt;SPAN style="mso-fareast-font-family: Arial; mso-bidi-font-family: Calibri; mso-fareast-language: EN-GB; mso-bidi-theme-font: minor-latin"&gt;Author and Scenario Designer&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0cm 0cm 0pt; LINE-HEIGHT: normal"&gt;&lt;FONT face=Calibri&gt;&lt;SPAN&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-ascii-font-family: Calibri; mso-fareast-font-family: "Times New Roman"; mso-hansi-font-family: Calibri; mso-bidi-font-family: Calibri; mso-fareast-language: EN-GB'&gt;&lt;FONT face=Calibri&gt;&lt;?xml:namespace prefix = "o" ns = "urn:schemas-microsoft-com:office:office" /&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&amp;nbsp;&lt;/P&gt;&lt;/BODY&gt;</ScenDescription>
