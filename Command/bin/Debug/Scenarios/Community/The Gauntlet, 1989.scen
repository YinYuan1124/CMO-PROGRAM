<?xml version="1.0"?>
<ScenContainer xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <ScenTitle>The Gauntlet, 1989</ScenTitle>
  <ScenDescription>&lt;BODY scroll=auto&gt;&lt;P class=MsoNormal style="TEXT-ALIGN: center; MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal" align=center&gt;&lt;B&gt;&lt;SPAN style="FONT-SIZE: 12pt; FONT-FAMILY: 'Calibri Light',sans-serif; mso-ascii-theme-font: major-latin; mso-fareast-font-family: 'Times New Roman'; mso-hansi-theme-font: major-latin; mso-bidi-font-family: 'Times New Roman'"&gt;The Gauntlet, Norwegian Sea, July 15-18, 1989&lt;?xml:namespace prefix = "o" ns = "urn:schemas-microsoft-com:office:office" /&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/B&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="TEXT-ALIGN: center; MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal" align=center&gt;&lt;B&gt;&lt;I style="mso-bidi-font-style: normal"&gt;&lt;U&gt;&lt;SPAN lang=EN style="FONT-SIZE: 12pt; FONT-FAMILY: 'Calibri Light',sans-serif; COLOR: red; mso-ascii-theme-font: major-latin; mso-fareast-font-family: 'Times New Roman'; mso-hansi-theme-font: major-latin; mso-bidi-font-family: 'Times New Roman'; mso-ansi-language: EN"&gt;Created Under Version 1.14 -&amp;nbsp;Build 998.11 – Database 475&lt;/SPAN&gt;&lt;/U&gt;&lt;/I&gt;&lt;/B&gt;&lt;B&gt;&lt;SPAN style="FONT-SIZE: 12pt; FONT-FAMILY: 'Calibri Light',sans-serif; mso-ascii-theme-font: major-latin; mso-fareast-font-family: 'Times New Roman'; mso-hansi-theme-font: major-latin; mso-bidi-font-family: 'Times New Roman'"&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/B&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="TEXT-ALIGN: center; MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal" align=center&gt;&lt;B&gt;&lt;SPAN style="FONT-SIZE: 12pt; FONT-FAMILY: 'Calibri Light',sans-serif; mso-ascii-theme-font: major-latin; mso-fareast-font-family: 'Times New Roman'; mso-hansi-theme-font: major-latin; mso-bidi-font-family: 'Times New Roman'"&gt;Al “Beirutdude” Sandrik&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/B&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="TEXT-ALIGN: center; MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal" align=center&gt;&lt;B&gt;&lt;SPAN style="FONT-SIZE: 12pt; FONT-FAMILY: 'Calibri Light',sans-serif; mso-ascii-theme-font: major-latin; mso-fareast-font-family: 'Times New Roman'; mso-hansi-theme-font: major-latin; mso-bidi-font-family: 'Times New Roman'"&gt;The Time Is: 15 July 1989 00:00 Zulu/01:00 Narvak Time&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/B&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="TEXT-ALIGN: center; MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal" align=center&gt;&lt;B style="mso-bidi-font-weight: normal"&gt;&lt;SPAN style="FONT-SIZE: 12pt; FONT-FAMILY: 'Calibri Light',sans-serif; mso-ascii-theme-font: major-latin; mso-fareast-font-family: 'Times New Roman'; mso-hansi-theme-font: major-latin; mso-bidi-font-family: 'Times New Roman'"&gt;Norwegian Sea&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/B&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="TEXT-ALIGN: center; MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal" align=center&gt;&lt;B&gt;&lt;SPAN style="FONT-SIZE: 12pt; FONT-FAMILY: 'Calibri Light',sans-serif; mso-ascii-theme-font: major-latin; mso-fareast-font-family: 'Times New Roman'; mso-hansi-theme-font: major-latin; mso-bidi-font-family: 'Times New Roman'"&gt;Playable as the NATO Side&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/B&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="TEXT-ALIGN: center; MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal" align=center&gt;&lt;B&gt;&lt;SPAN style="FONT-SIZE: 12pt; FONT-FAMILY: 'Calibri Light',sans-serif; mso-ascii-theme-font: major-latin; mso-fareast-font-family: 'Times New Roman'; mso-hansi-theme-font: major-latin; mso-bidi-font-family: 'Times New Roman'"&gt;Up to 4 days in Duration&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/B&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="TEXT-ALIGN: center; MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal" align=center&gt;&lt;B&gt;&lt;SPAN style="FONT-SIZE: 12pt; FONT-FAMILY: 'Calibri Light',sans-serif; mso-ascii-theme-font: major-latin; mso-fareast-font-family: 'Times New Roman'; mso-hansi-theme-font: major-latin; mso-bidi-font-family: 'Times New Roman'"&gt;Thanks to Whicker and AlexGGG for their help and advice!&lt;/SPAN&gt;&lt;/B&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="TEXT-ALIGN: center; MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal" align=center&gt;&lt;B&gt;&lt;SPAN style="FONT-SIZE: 12pt; FONT-FAMILY: 'Calibri Light',sans-serif; mso-ascii-theme-font: major-latin; mso-fareast-font-family: 'Times New Roman'; mso-hansi-theme-font: major-latin; mso-bidi-font-family: 'Times New Roman'"&gt;&lt;o:p&gt;&lt;FONT color=red&gt;Important! &lt;/FONT&gt;&lt;EM&gt;&lt;FONT color=red&gt;In order for the scenario to move the AI's missions with the Task Groups you MUST&amp;nbsp;activate (turn on)&amp;nbsp;the scenario for one or two seconds until the "Units Teleported" message pops up (If I teleport units using the&amp;nbsp;"scenario load" trigger it does not move the missions with the SAG).&lt;/FONT&gt;&lt;/EM&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/B&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal"&gt;&lt;B&gt;&lt;SPAN style="FONT-SIZE: 12pt; FONT-FAMILY: 'Calibri Light',sans-serif; mso-ascii-theme-font: major-latin; mso-fareast-font-family: 'Times New Roman'; mso-hansi-theme-font: major-latin; mso-bidi-font-family: 'Times New Roman'"&gt;Background: &lt;/SPAN&gt;&lt;/B&gt;&lt;SPAN style="FONT-SIZE: 12pt; FONT-FAMILY: 'Calibri Light',sans-serif; mso-ascii-theme-font: major-latin; mso-fareast-font-family: 'Times New Roman'; mso-hansi-theme-font: major-latin; mso-bidi-font-family: 'Times New Roman'; mso-bidi-font-weight: bold"&gt;U&lt;/SPAN&gt;&lt;SPAN style="FONT-SIZE: 12pt; FONT-FAMILY: 'Calibri Light',sans-serif; BACKGROUND: white; COLOR: #222222; mso-ascii-theme-font: major-latin; mso-fareast-font-family: 'Times New Roman'; mso-hansi-theme-font: major-latin; mso-bidi-font-family: Arial"&gt;nbeknownst &lt;/SPAN&gt;&lt;SPAN style="FONT-SIZE: 12pt; FONT-FAMILY: 'Calibri Light',sans-serif; mso-ascii-theme-font: major-latin; mso-fareast-font-family: 'Times New Roman'; mso-hansi-theme-font: major-latin; mso-bidi-font-family: 'Times New Roman'; mso-bidi-font-weight: bold"&gt;to NATO and Western intelligence agencies conditions within the Warsaw Pact began to shift during the spring of 1989. Dissent, always just below the surface, began to become more strident and animated with several dissident group homes being raided and activists arrested. In May a “safe house” near Werneuchen, GDR (near East Berlin) was raided by the Stasi with a large cache of western arms which the Stasi and GRU attributed both to the CIA and the FGR’s BND. Eastern Bloc leaders quickly came to the understanding that if they didn’t do something quickly they, and the governments they represent, would soon be swept into the “dust bin of history.” Their choices were stark either they launched a crackdown on an increasingly restive population or lance the Western boil encouraging that dissent. They chose war!&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal"&gt;&lt;SPAN style="FONT-SIZE: 12pt; FONT-FAMILY: 'Calibri Light',sans-serif; mso-ascii-theme-font: major-latin; mso-fareast-font-family: 'Times New Roman'; mso-hansi-theme-font: major-latin; mso-bidi-font-family: 'Times New Roman'; mso-bidi-font-weight: bold"&gt;In the pre-dawn hours of July 1&lt;SUP&gt;st&lt;/SUP&gt; airstrikes, missile attacks and artillery barrages lit up the night skies all long the Inter-German Frontier. By that evening, four armored columns had pushed into the NORTHAG’s, North German Plain making good progress, but in the more hilly and wooded CENTAG sector problems cropped up early with Pact forces caught in huge traffic jams. By July 8&lt;SUP&gt;th&lt;/SUP&gt; the front in Germany began to bog down on all fronts as sabotage to Pact rail lines inhibited both follow on echelons and resupply for the heavily engaged armies. HUMINT was indicating to &lt;I style="mso-bidi-font-style: normal"&gt;STAVKA&lt;/I&gt; and the GRU that NATO was actually building up a reserve force for a possible counter attack and the growing Allied REFORGER airlift and convoy operations (several of the SL-7 33 knot container ships and USMC MPS vessels had already arrived) were beginning to tip the balance in NATOs favor. &lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal"&gt;&lt;SPAN style="FONT-SIZE: 12pt; FONT-FAMILY: 'Calibri Light',sans-serif; mso-ascii-theme-font: major-latin; mso-fareast-font-family: 'Times New Roman'; mso-hansi-theme-font: major-latin; mso-bidi-font-family: 'Times New Roman'; mso-bidi-font-weight: bold"&gt;In Norway, Soviet airmobile forces quickly overran the Banak Air Base rapidly followed on by elements of the 76&lt;SUP&gt;th&lt;/SUP&gt; Guards Airborne Division. On Svalbard Island Soviet Spetznaz and Paratroopers quickly took Longyear Airport startling the staff. They were further amazed an hour later when an amphibious vessel and tanker arrived disgorging engineers. By the 7&lt;SUP&gt;th&lt;/SUP&gt; the airport was ready to take MPA and ASW aircraft making patrol of the Norwegian Sea much easier. &lt;SPAN style="mso-spacerun: yes"&gt;&amp;nbsp;&lt;/SPAN&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal"&gt;&lt;SPAN style="FONT-SIZE: 12pt; FONT-FAMILY: 'Calibri Light',sans-serif; mso-ascii-theme-font: major-latin; mso-fareast-font-family: 'Times New Roman'; mso-hansi-theme-font: major-latin; mso-bidi-font-family: 'Times New Roman'; mso-bidi-font-weight: bold"&gt;By July 10&lt;SUP&gt;th&lt;/SUP&gt; the 45&lt;SUP&gt;th&lt;/SUP&gt; and 54&lt;SUP&gt;th&lt;/SUP&gt; Motorized Rifle Divisions were posed for an offensive to clear the coast as far as Narvik possibly with an amphibious landing by the 34&lt;SUP&gt;th&lt;/SUP&gt; Naval Infantry Brigade. With the entire war effort now hinging on interdicting the NATO convoys the Soviet Navy and Naval Aviation would have to break out into the Atlantic but first they needed to take Tromso to make that task easier for Naval Aviation. Over the past few days they had been building up air assets in the Kola Peninsula as well as consolidating two (2) SAGs, including one centered on the CVGH Kiev,&amp;nbsp;into one larger one to maximize Soviet striking power. Finland has granted limited overflight rights to the Soviets over extreme northern Finland.&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal"&gt;&lt;B&gt;&lt;SPAN style="FONT-SIZE: 12pt; FONT-FAMILY: 'Calibri Light',sans-serif; mso-ascii-theme-font: major-latin; mso-fareast-font-family: 'Times New Roman'; mso-hansi-theme-font: major-latin; mso-bidi-font-family: 'Times New Roman'"&gt;The Soviets were aware the NATO ACE Mobile Force would try to reinforce Norway and first they must be stopped. Everything hung on interdicting the NATO reinforcement of Norway! &lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/B&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal"&gt;&lt;SPAN style="FONT-SIZE: 12pt; FONT-FAMILY: 'Calibri Light',sans-serif; mso-ascii-theme-font: major-latin; mso-fareast-font-family: 'Times New Roman'; mso-hansi-theme-font: major-latin; mso-bidi-font-family: 'Times New Roman'; mso-bidi-font-weight: bold"&gt;NATO having cleared both the Mediterranean and Atlantic of most Soviet naval assets and especially the few submarines that ventured south of the GIUK Gap was now in a position to return to the Norwegian Sea. Between 10 and 14 July several submarine transited the Gap into what had become a Soviet Lake. On the 14&lt;SUP&gt;th&lt;/SUP&gt; NATO would return in a big way to make sure Narvik did not fall! Your mission is to deliver the two Amphibious Ready Groups centered on the USS Iwo Jima (LPH-2) and the HMS Ocean (L11) to Narvik (&lt;B&gt;The area represented by the locked reference points in the Norwegian fjord near Bodo and Andoya&lt;/B&gt;) and possibly bring the Warsaw Pact offensive to a halt.&lt;SPAN style="mso-spacerun: yes"&gt;&amp;nbsp; &lt;/SPAN&gt;It is time to run “The Gauntlet!”&lt;/SPAN&gt;&lt;SPAN style="FONT-SIZE: 12pt; FONT-FAMILY: 'Calibri Light',sans-serif; mso-ascii-theme-font: major-latin; mso-fareast-font-family: 'Times New Roman'; mso-hansi-theme-font: major-latin; mso-bidi-font-family: 'Times New Roman'"&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal"&gt;&lt;B style="mso-bidi-font-weight: normal"&gt;&lt;SPAN style="FONT-SIZE: 12pt; FONT-FAMILY: 'Calibri Light',sans-serif; mso-ascii-theme-font: major-latin; mso-fareast-font-family: 'Times New Roman'; mso-hansi-theme-font: major-latin; mso-bidi-font-family: 'Times New Roman'"&gt;Designer’s Notes:&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/B&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 0pt 0.5in; LINE-HEIGHT: normal; TEXT-INDENT: -0.25in"&gt;&lt;B style="mso-bidi-font-weight: normal"&gt;&lt;SPAN style="FONT-SIZE: 12pt; FONT-FAMILY: 'Calibri Light',sans-serif; COLOR: red; mso-ascii-theme-font: major-latin; mso-fareast-font-family: 'Times New Roman'; mso-hansi-theme-font: major-latin; mso-bidi-font-family: 'Times New Roman'"&gt;1.&lt;/SPAN&gt;&lt;/B&gt;&lt;B style="mso-bidi-font-weight: normal"&gt;&lt;SPAN style="FONT-SIZE: 7pt; FONT-FAMILY: 'Calibri Light',sans-serif; COLOR: red; mso-ascii-theme-font: major-latin; mso-fareast-font-family: 'Times New Roman'; mso-hansi-theme-font: major-latin; mso-bidi-font-family: 'Times New Roman'"&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;/SPAN&gt;&lt;/B&gt;&lt;B style="mso-bidi-font-weight: normal"&gt;&lt;I style="mso-bidi-font-style: normal"&gt;&lt;U&gt;&lt;SPAN style="FONT-SIZE: 12pt; FONT-FAMILY: 'Calibri Light',sans-serif; COLOR: red; mso-ascii-theme-font: major-latin; mso-fareast-font-family: 'Times New Roman'; mso-hansi-theme-font: major-latin; mso-bidi-font-family: 'Times New Roman'"&gt;This scenario is big! Really big!&lt;/SPAN&gt;&lt;/U&gt;&lt;/I&gt;&lt;/B&gt;&lt;SPAN style="FONT-SIZE: 12pt; FONT-FAMILY: 'Calibri Light',sans-serif; mso-ascii-theme-font: major-latin; mso-fareast-font-family: 'Times New Roman'; mso-hansi-theme-font: major-latin; mso-bidi-font-family: 'Times New Roman'"&gt; I worked on it for about a month and a half and &lt;B style="mso-bidi-font-weight: normal"&gt;&lt;SPAN style="COLOR: red"&gt;it will run slowly&lt;/SPAN&gt;&lt;/B&gt; at times until the unit kills makes it more manageable. Units will die quickly, lots of them, but through, at least, day 2 you will only be able to speed it up so much. &lt;B style="mso-bidi-font-weight: normal"&gt;&lt;SPAN style="COLOR: red"&gt;You have been warned!&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/B&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 0pt 0.5in; LINE-HEIGHT: normal; TEXT-INDENT: -0.25in"&gt;&lt;B style="mso-bidi-font-weight: normal"&gt;&lt;SPAN style="FONT-SIZE: 12pt; FONT-FAMILY: 'Calibri Light',sans-serif; COLOR: red; mso-ascii-theme-font: major-latin; mso-fareast-font-family: 'Times New Roman'; mso-hansi-theme-font: major-latin; mso-bidi-font-family: 'Times New Roman'"&gt;2.&lt;/SPAN&gt;&lt;/B&gt;&lt;B style="mso-bidi-font-weight: normal"&gt;&lt;SPAN style="FONT-SIZE: 7pt; FONT-FAMILY: 'Calibri Light',sans-serif; COLOR: red; mso-ascii-theme-font: major-latin; mso-fareast-font-family: 'Times New Roman'; mso-hansi-theme-font: major-latin; mso-bidi-font-family: 'Times New Roman'"&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;/SPAN&gt;&lt;/B&gt;&lt;B style="mso-bidi-font-weight: normal"&gt;&lt;SPAN style="FONT-SIZE: 12pt; FONT-FAMILY: 'Calibri Light',sans-serif; COLOR: red; mso-ascii-theme-font: major-latin; mso-fareast-font-family: 'Times New Roman'; mso-hansi-theme-font: major-latin; mso-bidi-font-family: 'Times New Roman'"&gt;I suggest you pause the game before saving it.&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/B&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 0pt 0.5in; LINE-HEIGHT: normal; TEXT-INDENT: -0.25in"&gt;&lt;SPAN style="FONT-SIZE: 12pt; FONT-FAMILY: 'Calibri Light',sans-serif; mso-ascii-theme-font: major-latin; mso-fareast-font-family: 'Times New Roman'; mso-hansi-theme-font: major-latin; mso-bidi-font-family: 'Times New Roman'"&gt;3.&lt;/SPAN&gt;&lt;SPAN style="FONT-SIZE: 7pt; FONT-FAMILY: 'Calibri Light',sans-serif; mso-ascii-theme-font: major-latin; mso-fareast-font-family: 'Times New Roman'; mso-hansi-theme-font: major-latin; mso-bidi-font-family: 'Times New Roman'"&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;/SPAN&gt;&lt;SPAN style="FONT-SIZE: 12pt; FONT-FAMILY: 'Calibri Light',sans-serif; mso-ascii-theme-font: major-latin; mso-fareast-font-family: 'Times New Roman'; mso-hansi-theme-font: major-latin; mso-bidi-font-family: 'Times New Roman'"&gt;Some units teleport with the scenario load to add some game to game randomness &lt;STRONG&gt;&lt;FONT color=red&gt;&lt;EM&gt;&lt;U&gt;please run the scenario for one or two seconds before setting up missions&lt;/U&gt;&lt;/EM&gt;&lt;/FONT&gt;&lt;/STRONG&gt;. Also all NATO units not teleported have a northward track set until you change them.&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 0pt 0.5in; LINE-HEIGHT: normal; TEXT-INDENT: -0.25in"&gt;&lt;SPAN style="FONT-SIZE: 12pt; FONT-FAMILY: 'Calibri Light',sans-serif; mso-ascii-theme-font: major-latin; mso-fareast-font-family: 'Times New Roman'; mso-hansi-theme-font: major-latin; mso-bidi-font-family: 'Times New Roman'"&gt;4.&lt;/SPAN&gt;&lt;SPAN style="FONT-SIZE: 7pt; FONT-FAMILY: 'Calibri Light',sans-serif; mso-ascii-theme-font: major-latin; mso-fareast-font-family: 'Times New Roman'; mso-hansi-theme-font: major-latin; mso-bidi-font-family: 'Times New Roman'"&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;/SPAN&gt;&lt;SPAN style="FONT-SIZE: 12pt; FONT-FAMILY: 'Calibri Light',sans-serif; mso-ascii-theme-font: major-latin; mso-fareast-font-family: 'Times New Roman'; mso-hansi-theme-font: major-latin; mso-bidi-font-family: 'Times New Roman'"&gt;Speaking of missions I have not assigned any for NATO, so it is up to you!&lt;SPAN style="mso-spacerun: yes"&gt;&amp;nbsp; &lt;/SPAN&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 0pt 0.5in; LINE-HEIGHT: normal; TEXT-INDENT: -0.25in"&gt;&lt;SPAN style="FONT-SIZE: 12pt; FONT-FAMILY: 'Calibri Light',sans-serif; mso-ascii-theme-font: major-latin; mso-fareast-font-family: 'Times New Roman'; mso-hansi-theme-font: major-latin; mso-bidi-font-family: 'Times New Roman'"&gt;5.&lt;/SPAN&gt;&lt;SPAN style="FONT-SIZE: 7pt; FONT-FAMILY: 'Calibri Light',sans-serif; mso-ascii-theme-font: major-latin; mso-fareast-font-family: 'Times New Roman'; mso-hansi-theme-font: major-latin; mso-bidi-font-family: 'Times New Roman'"&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/SPAN&gt;&lt;FONT face=Calibri&gt;&lt;SPAN style="FONT-SIZE: 12pt; mso-fareast-font-family: Calibri; mso-bidi-font-family: 'Times New Roman'; mso-bidi-font-style: italic"&gt;The greatest number of Victory Points are achieved by &lt;/SPAN&gt;&lt;SPAN style="FONT-SIZE: 12pt; mso-fareast-font-family: 'Times New Roman'; mso-bidi-font-family: 'Times New Roman'; mso-bidi-font-style: italic; mso-ascii-font-family: Calibri; mso-hansi-font-family: Calibri"&gt;reinforcing the Norwegian Brigade North. Preset operations plans have been implemented and the Allied Command Europe (ACE) Mobile Force will be deployed to Norway. &lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 0pt 0.5in; LINE-HEIGHT: normal; TEXT-INDENT: 0.5in"&gt;&lt;SPAN style="FONT-SIZE: 12pt; mso-fareast-font-family: 'Times New Roman'; mso-bidi-font-family: 'Times New Roman'; mso-bidi-font-style: italic; mso-ascii-font-family: Calibri; mso-hansi-font-family: Calibri"&gt;&lt;FONT face=Calibri&gt;a. TF 22.1, The 24th Marine Amphibious Unit (MAU) aboard Amphibious Ready Group (ARG) 2-89 under the command of PHIBRON 8 (on USS Iwo Jima) will deploy to the Ofotfjorden/Narvik area. &lt;B style="mso-bidi-font-weight: normal"&gt;This amphibious operations area is represented by the locked reference points in the Norwegian fjord between Bodo and Andoya&lt;/B&gt;. &lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 0pt 0.5in; LINE-HEIGHT: normal; TEXT-INDENT: 0.5in"&gt;&lt;SPAN style="FONT-SIZE: 12pt; mso-fareast-font-family: 'Times New Roman'; mso-bidi-font-family: 'Times New Roman'; mso-bidi-font-style: italic; mso-ascii-font-family: Calibri; mso-hansi-font-family: Calibri"&gt;&lt;FONT face=Calibri&gt;b. TF 22.2, The Royal Naval and French Amphibious Ready Group under HMS Ocean. This ARG is carrying 29&lt;SUP&gt;th&lt;/SUP&gt; Royal Artillery, 42&lt;SUP&gt;nd&lt;/SUP&gt; and 45&lt;SUP&gt;th&lt;/SUP&gt; Commando and Dutch Marines (on the French ships). &lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 0pt 0.5in; LINE-HEIGHT: normal; TEXT-INDENT: 0.5in"&gt;&lt;SPAN style="FONT-SIZE: 12pt; mso-fareast-font-family: 'Times New Roman'; mso-bidi-font-family: 'Times New Roman'; mso-bidi-font-style: italic; mso-ascii-font-family: Calibri; mso-hansi-font-family: Calibri"&gt;&lt;FONT face=Calibri&gt;c. Each amphibious vessel will have to be in that area for 24 hours (offloading) to gain points. &lt;B style="mso-bidi-font-weight: normal"&gt;&lt;I&gt;&lt;U&gt;After the last amphibious vessel unloads, 24 hours after it enters the fjord, you can consider the mission a success (if you like and are happy with your score) and end the game&lt;/U&gt;&lt;/I&gt;&lt;U&gt;.&lt;/U&gt;&lt;/B&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 0pt 0.5in; LINE-HEIGHT: normal; TEXT-INDENT: 0.5in"&gt;&lt;SPAN style="FONT-SIZE: 12pt; FONT-FAMILY: 'Calibri Light',sans-serif; mso-ascii-theme-font: major-latin; mso-fareast-font-family: 'Times New Roman'; mso-hansi-theme-font: major-latin; mso-bidi-font-family: 'Times New Roman'"&gt;&lt;o:p&gt;&amp;nbsp;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 0pt 0.5in; LINE-HEIGHT: normal; TEXT-INDENT: 0.5in"&gt;&lt;SPAN style="FONT-SIZE: 12pt; FONT-FAMILY: 'Calibri Light',sans-serif; mso-ascii-theme-font: major-latin; mso-fareast-font-family: 'Times New Roman'; mso-hansi-theme-font: major-latin; mso-bidi-font-family: 'Times New Roman'"&gt;d. &lt;B style="mso-bidi-font-weight: normal"&gt;&lt;SPAN style="COLOR: red"&gt;Important &lt;/SPAN&gt;&lt;/B&gt;: &lt;I style="mso-bidi-font-style: normal"&gt;The locked reference points you need the two Amphibious Groups to reach are named&lt;/I&gt; “&lt;B style="mso-bidi-font-weight: normal"&gt;VP Area 1&lt;/B&gt;” &lt;I style="mso-bidi-font-style: normal"&gt;through&lt;/I&gt; “&lt;B style="mso-bidi-font-weight: normal"&gt;VP Area 14&lt;/B&gt;.”&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 0pt 0.5in; LINE-HEIGHT: normal; TEXT-INDENT: 0.5in"&gt;&lt;SPAN style="FONT-SIZE: 12pt; mso-fareast-font-family: 'Times New Roman'; mso-bidi-font-family: 'Times New Roman'; mso-bidi-font-style: italic; mso-ascii-font-family: Calibri; mso-hansi-font-family: Calibri"&gt;&lt;o:p&gt;&lt;FONT face=Calibri&gt;&amp;nbsp;&lt;/FONT&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 0pt 0.5in; LINE-HEIGHT: normal; TEXT-INDENT: -0.25in"&gt;&lt;SPAN style="FONT-SIZE: 12pt; FONT-FAMILY: 'Calibri Light',sans-serif; mso-ascii-theme-font: major-latin; mso-fareast-font-family: 'Times New Roman'; mso-hansi-theme-font: major-latin; mso-bidi-font-family: 'Times New Roman'"&gt;6.&lt;SPAN style="mso-tab-count: 1"&gt;&amp;nbsp;&amp;nbsp; &lt;/SPAN&gt;Some airbases (On both sides) have “Composite Squadrons” If an air base was unlikely to be struck I didn’t include units in maintenance and used single unit airfields. So consider a squadron with 12 or 24 fully available aircraft to be a composite squadron and the “hanger queens” are not accounted for. &lt;B style="mso-bidi-font-weight: normal"&gt;&lt;I style="mso-bidi-font-style: normal"&gt;Most of the other squadrons have been in combat for two weeks and have suffered 30 to 50 percent combat losses and damage along with normal maintenance.&lt;/I&gt;&lt;/B&gt; Only the ARG helio squadrons are fresh and at full strength. &lt;/SPAN&gt;&lt;SPAN style="FONT-SIZE: 12pt; mso-fareast-font-family: 'Times New Roman'; mso-bidi-font-family: 'Times New Roman'; mso-bidi-font-style: italic; mso-ascii-font-family: Calibri; mso-hansi-font-family: Calibri"&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 0pt 0.5in; LINE-HEIGHT: normal; TEXT-INDENT: -0.25in"&gt;&lt;SPAN style="FONT-SIZE: 12pt; FONT-FAMILY: 'Calibri Light',sans-serif; mso-ascii-theme-font: major-latin; mso-fareast-font-family: 'Times New Roman'; mso-hansi-theme-font: major-latin; mso-bidi-font-family: 'Times New Roman'"&gt;7.&lt;/SPAN&gt;&lt;SPAN style="FONT-SIZE: 7pt; FONT-FAMILY: 'Calibri Light',sans-serif; mso-ascii-theme-font: major-latin; mso-fareast-font-family: 'Times New Roman'; mso-hansi-theme-font: major-latin; mso-bidi-font-family: 'Times New Roman'"&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;/SPAN&gt;&lt;SPAN style="FONT-SIZE: 12pt; FONT-FAMILY: 'Calibri Light',sans-serif; mso-ascii-theme-font: major-latin; mso-fareast-font-family: 'Times New Roman'; mso-hansi-theme-font: major-latin; mso-bidi-font-family: 'Times New Roman'"&gt;Some bases in the northern UK are assigned aircraft squadrons which are actually based further south. This is to avoid a number of “useless bases” down there (out of harm’s way). Please understand the bases represent the RAF more than its’ actual 1989 OOB. &lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 0pt 0.5in; LINE-HEIGHT: normal; TEXT-INDENT: -0.25in"&gt;&lt;SPAN style="FONT-SIZE: 12pt; FONT-FAMILY: 'Calibri Light',sans-serif; mso-ascii-theme-font: major-latin; mso-fareast-font-family: 'Times New Roman'; mso-hansi-theme-font: major-latin; mso-bidi-font-family: 'Times New Roman'"&gt;8.&lt;/SPAN&gt;&lt;SPAN style="FONT-SIZE: 7pt; FONT-FAMILY: 'Calibri Light',sans-serif; mso-ascii-theme-font: major-latin; mso-fareast-font-family: 'Times New Roman'; mso-hansi-theme-font: major-latin; mso-bidi-font-family: 'Times New Roman'"&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;/SPAN&gt;&lt;SPAN style="FONT-SIZE: 12pt; FONT-FAMILY: 'Calibri Light',sans-serif; mso-ascii-theme-font: major-latin; mso-fareast-font-family: 'Times New Roman'; mso-hansi-theme-font: major-latin; mso-bidi-font-family: 'Times New Roman'"&gt;The bases at Bodo and Orland, Norway are stocked to support a &lt;B style="mso-bidi-font-weight: normal"&gt;&lt;I style="mso-bidi-font-style: normal"&gt;limited number of RAF and USAF sorties&lt;/I&gt;&lt;/B&gt; if you transfer those aircraft there. I like to give players problems to solve and what you relocate and where you send them is one of those problems. You have four days to reposition your forces but always keep in mind your goal is protecting/shepherding the ARGs to Narvak! &lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 0pt 0.5in; LINE-HEIGHT: normal; TEXT-INDENT: -0.25in"&gt;&lt;SPAN style="FONT-SIZE: 12pt; FONT-FAMILY: 'Calibri Light',sans-serif; mso-ascii-theme-font: major-latin; mso-fareast-font-family: 'Times New Roman'; mso-hansi-theme-font: major-latin; mso-bidi-font-family: 'Times New Roman'"&gt;9.&lt;/SPAN&gt;&lt;SPAN style="FONT-SIZE: 7pt; FONT-FAMILY: 'Calibri Light',sans-serif; mso-ascii-theme-font: major-latin; mso-fareast-font-family: 'Times New Roman'; mso-hansi-theme-font: major-latin; mso-bidi-font-family: 'Times New Roman'"&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;/SPAN&gt;&lt;B style="mso-bidi-font-weight: normal"&gt;&lt;SPAN style="FONT-SIZE: 12pt; FONT-FAMILY: 'Calibri Light',sans-serif; COLOR: red; mso-ascii-theme-font: major-latin; mso-fareast-font-family: 'Times New Roman'; mso-hansi-theme-font: major-latin; mso-bidi-font-family: 'Times New Roman'"&gt;Please don’t change to unlimited magazines&lt;/SPAN&gt;&lt;/B&gt;&lt;SPAN style="FONT-SIZE: 12pt; FONT-FAMILY: 'Calibri Light',sans-serif; mso-ascii-theme-font: major-latin; mso-fareast-font-family: 'Times New Roman'; mso-hansi-theme-font: major-latin; mso-bidi-font-family: 'Times New Roman'"&gt;, I made a deliberate choice in how many loadouts to deploy to those fields. &lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 0pt 0.5in; LINE-HEIGHT: normal; TEXT-INDENT: -0.25in"&gt;&lt;SPAN style="FONT-SIZE: 12pt; FONT-FAMILY: 'Calibri Light',sans-serif; mso-ascii-theme-font: major-latin; mso-fareast-font-family: 'Times New Roman'; mso-hansi-theme-font: major-latin; mso-bidi-font-family: 'Times New Roman'"&gt;10.&lt;SPAN style="mso-tab-count: 1"&gt; &lt;/SPAN&gt;&lt;/SPAN&gt;&lt;SPAN style="FONT-SIZE: 7pt; FONT-FAMILY: 'Calibri Light',sans-serif; mso-ascii-theme-font: major-latin; mso-fareast-font-family: 'Times New Roman'; mso-hansi-theme-font: major-latin; mso-bidi-font-family: 'Times New Roman'"&gt;&lt;/SPAN&gt;&lt;SPAN style="FONT-SIZE: 12pt; FONT-FAMILY: 'Calibri Light',sans-serif; mso-ascii-theme-font: major-latin; mso-fareast-font-family: 'Times New Roman'; mso-hansi-theme-font: major-latin; mso-bidi-font-family: 'Times New Roman'"&gt;Evenes, Bardufoss and Andoya air force bases can also support some other NATO aircraft (other than Norwegian F-16s) but are even more extremely limited. They were under heavy bombardment and the same is true for Banak for the Soviets. The base was limited in the type of aircraft and loadouts. &lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 0pt 0.5in; LINE-HEIGHT: normal; TEXT-INDENT: -0.25in"&gt;&lt;SPAN style="FONT-SIZE: 12pt; FONT-FAMILY: 'Calibri Light',sans-serif; mso-ascii-theme-font: major-latin; mso-fareast-font-family: 'Times New Roman'; mso-hansi-theme-font: major-latin; mso-bidi-font-family: 'Times New Roman'"&gt;11.&lt;/SPAN&gt;&lt;SPAN style="FONT-SIZE: 7pt; FONT-FAMILY: 'Calibri Light',sans-serif; mso-ascii-theme-font: major-latin; mso-fareast-font-family: 'Times New Roman'; mso-hansi-theme-font: major-latin; mso-bidi-font-family: 'Times New Roman'"&gt;&amp;nbsp; &lt;/SPAN&gt;&lt;SPAN style="FONT-SIZE: 12pt; FONT-FAMILY: 'Calibri Light',sans-serif; mso-ascii-theme-font: major-latin; mso-fareast-font-family: 'Times New Roman'; mso-hansi-theme-font: major-latin; mso-bidi-font-family: 'Times New Roman'"&gt;I gave aircraft the load outs I would have used for the opening moves. If you don’t like the load outs I chose either change them in the scenario editor or the scenario itself. &lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 0pt 0.5in; LINE-HEIGHT: normal; TEXT-INDENT: -0.25in"&gt;&lt;SPAN style="FONT-SIZE: 12pt; FONT-FAMILY: 'Calibri Light',sans-serif; mso-ascii-theme-font: major-latin; mso-fareast-font-family: 'Times New Roman'; mso-hansi-theme-font: major-latin; mso-bidi-font-family: 'Times New Roman'"&gt;12.&lt;/SPAN&gt;&lt;SPAN style="FONT-SIZE: 7pt; FONT-FAMILY: 'Calibri Light',sans-serif; mso-ascii-theme-font: major-latin; mso-fareast-font-family: 'Times New Roman'; mso-hansi-theme-font: major-latin; mso-bidi-font-family: 'Times New Roman'"&gt;&amp;nbsp; &lt;/SPAN&gt;&lt;SPAN style="FONT-SIZE: 12pt; FONT-FAMILY: 'Calibri Light',sans-serif; mso-ascii-theme-font: major-latin; mso-fareast-font-family: 'Times New Roman'; mso-hansi-theme-font: major-latin; mso-bidi-font-family: 'Times New Roman'"&gt;You have tanker and AEW support!&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 0pt 0.5in; LINE-HEIGHT: normal; TEXT-INDENT: -0.25in"&gt;&lt;SPAN style="FONT-SIZE: 12pt; FONT-FAMILY: 'Calibri Light',sans-serif; mso-ascii-theme-font: major-latin; mso-fareast-font-family: 'Times New Roman'; mso-hansi-theme-font: major-latin; mso-bidi-font-family: 'Times New Roman'"&gt;13.&lt;/SPAN&gt;&lt;SPAN style="FONT-SIZE: 7pt; FONT-FAMILY: 'Calibri Light',sans-serif; mso-ascii-theme-font: major-latin; mso-fareast-font-family: 'Times New Roman'; mso-hansi-theme-font: major-latin; mso-bidi-font-family: 'Times New Roman'"&gt;&amp;nbsp; &lt;/SPAN&gt;&lt;SPAN style="FONT-SIZE: 12pt; FONT-FAMILY: 'Calibri Light',sans-serif; mso-ascii-theme-font: major-latin; mso-fareast-font-family: 'Times New Roman'; mso-hansi-theme-font: major-latin; mso-bidi-font-family: 'Times New Roman'"&gt;Vessels which might be damaged or use up their loadouts have home ports to return to. This has happened during my playtests so they have them. BTW TF 21.2 (the former Theodore Roosevelt’s CVBG) has been in combat in the Med for almost two weeks and many systems are down for maintenance or repair of combat damage (shock effects mainly). &lt;SPAN style="mso-spacerun: yes"&gt;&amp;nbsp;&lt;/SPAN&gt;The Roosevelt was hit by two (2) AS-4 Kitchen missiles and is in Toulon for emergency repairs before being sent back to Portsmouth Naval Shipyard, VA for more substantial repairs.&lt;SPAN style="mso-spacerun: yes"&gt;&amp;nbsp; &lt;/SPAN&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 8pt 0.5in; LINE-HEIGHT: normal; TEXT-INDENT: -0.25in"&gt;&lt;SPAN style="FONT-SIZE: 12pt; FONT-FAMILY: 'Calibri Light',sans-serif; mso-ascii-theme-font: major-latin; mso-fareast-font-family: 'Times New Roman'; mso-hansi-theme-font: major-latin; mso-bidi-font-family: 'Times New Roman'"&gt;14.&lt;/SPAN&gt;&lt;SPAN style="FONT-SIZE: 7pt; FONT-FAMILY: 'Calibri Light',sans-serif; mso-ascii-theme-font: major-latin; mso-fareast-font-family: 'Times New Roman'; mso-hansi-theme-font: major-latin; mso-bidi-font-family: 'Times New Roman'"&gt;&amp;nbsp; &lt;/SPAN&gt;&lt;SPAN style="FONT-SIZE: 12pt; FONT-FAMILY: 'Calibri Light',sans-serif; mso-ascii-theme-font: major-latin; mso-fareast-font-family: 'Times New Roman'; mso-hansi-theme-font: major-latin; mso-bidi-font-family: 'Times New Roman'"&gt;There are AOs and AOEs available for UNREP (I believe they will automatically dispatch to unrep a vessel or you can use the drop down menu). They are detached from the TFs as they were doing interesting things like trying to take an entire battle group to unrep the Iwo Jima! So they are near but not attached to their primary TF. &lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal"&gt;&lt;B&gt;&lt;SPAN lang=EN style="FONT-SIZE: 12pt; FONT-FAMILY: 'Calibri Light',sans-serif; mso-ascii-theme-font: major-latin; mso-fareast-font-family: 'Times New Roman'; mso-hansi-theme-font: major-latin; mso-bidi-font-family: 'Times New Roman'; mso-ansi-language: EN"&gt;Created Under Version 1.14 -&amp;nbsp;Build 998.11 – Data Base 745&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/B&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal"&gt;&lt;B&gt;&lt;SPAN lang=EN style="FONT-SIZE: 12pt; FONT-FAMILY: 'Calibri Light',sans-serif; mso-ascii-theme-font: major-latin; mso-fareast-font-family: 'Times New Roman'; mso-hansi-theme-font: major-latin; mso-bidi-font-family: 'Times New Roman'; mso-ansi-language: EN"&gt;An .INI and Delta File have been provided for rebuilds&lt;/SPAN&gt;&lt;/B&gt;&lt;SPAN lang=EN style="FONT-SIZE: 12pt; FONT-FAMILY: 'Calibri Light',sans-serif; mso-ascii-theme-font: major-latin; mso-fareast-font-family: 'Times New Roman'; mso-hansi-theme-font: major-latin; mso-bidi-font-family: 'Times New Roman'; mso-ansi-language: EN"&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal"&gt;&lt;SPAN lang=EN style="FONT-SIZE: 12pt; FONT-FAMILY: 'Calibri Light',sans-serif; mso-ascii-theme-font: major-latin; mso-fareast-font-family: 'Times New Roman'; mso-hansi-theme-font: major-latin; mso-bidi-font-family: 'Times New Roman'; mso-ansi-language: EN"&gt;Al “BeirutDude” Sandrik (ex-Beachinnole)&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal"&gt;&lt;U&gt;&lt;SPAN lang=EN style="FONT-SIZE: 12pt; FONT-FAMILY: 'Calibri Light',sans-serif; COLOR: blue; mso-ascii-theme-font: major-latin; mso-fareast-font-family: 'Times New Roman'; mso-hansi-theme-font: major-latin; mso-bidi-font-family: 'Times New Roman'; mso-ansi-language: EN"&gt;&lt;A href="mailto:Al.Sandrik@gmail.com"&gt;&lt;SPAN style="COLOR: blue"&gt;Al.Sandrik@gmail.com&lt;/SPAN&gt;&lt;/A&gt;&lt;/SPAN&gt;&lt;/U&gt;&lt;/P&gt;&lt;/BODY&gt;</ScenDescription>
