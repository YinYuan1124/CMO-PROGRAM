<?xml version="1.0"?>
<ScenContainer xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <ScenTitle>Mediterranean Tsunami 2019</ScenTitle>
  <ScenDescription>&lt;BODY scroll=auto&gt;&lt;P class=MsoNormal style="TEXT-ALIGN: center; MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal" align=center&gt;&lt;B&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-ascii-font-family: Calibri; mso-fareast-font-family: "Times New Roman"; mso-hansi-font-family: Calibri; mso-bidi-font-family: "Times New Roman"'&gt;&lt;?xml:namespace prefix = "o" ns = "urn:schemas-microsoft-com:office:office" /&gt;&lt;o:p&gt;&lt;FONT face=Calibri&gt;&amp;nbsp;&lt;/FONT&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/B&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="TEXT-ALIGN: center; MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal" align=center&gt;&lt;B&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-ascii-font-family: Calibri; mso-fareast-font-family: "Times New Roman"; mso-hansi-font-family: Calibri; mso-bidi-font-family: "Times New Roman"'&gt;&lt;FONT face=Calibri&gt;Mediterranean Tsunami 05-01-2019&lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/B&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="TEXT-ALIGN: center; MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal" align=center&gt;&lt;B&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-ascii-font-family: Calibri; mso-fareast-font-family: "Times New Roman"; mso-hansi-font-family: Calibri; mso-bidi-font-family: "Times New Roman"'&gt;&lt;FONT face=Calibri&gt;“&lt;I style="mso-bidi-font-style: normal"&gt;&lt;SPAN style="COLOR: red"&gt;In HARMs Way&lt;/SPAN&gt;&lt;/I&gt;!”&lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/B&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="TEXT-ALIGN: center; MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal" align=center&gt;&lt;B&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-ascii-font-family: Calibri; mso-fareast-font-family: "Times New Roman"; mso-hansi-font-family: Calibri; mso-bidi-font-family: "Times New Roman"'&gt;&lt;FONT face=Calibri&gt;The Time Is: 1 May 2019, 04:00 Zulu/6:00 Beirut Time&lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/B&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="TEXT-ALIGN: center; MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal" align=center&gt;&lt;FONT face=Calibri&gt;&lt;B&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-ascii-font-family: Calibri; mso-fareast-font-family: "Times New Roman"; mso-hansi-font-family: Calibri; mso-bidi-font-family: "Times New Roman"'&gt;Eastern Mediterranean Sea&lt;/SPAN&gt;&lt;/B&gt;&lt;SPAN style='FONT-SIZE: 12pt; FONT-FAMILY: "Times New Roman",serif; mso-fareast-font-family: "Times New Roman"'&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="TEXT-ALIGN: center; MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal" align=center&gt;&lt;FONT face=Calibri&gt;&lt;B&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-ascii-font-family: Calibri; mso-fareast-font-family: "Times New Roman"; mso-hansi-font-family: Calibri; mso-bidi-font-family: "Times New Roman"'&gt;Playable as either Russia or NATO&lt;/SPAN&gt;&lt;/B&gt;&lt;SPAN style='FONT-SIZE: 12pt; FONT-FAMILY: "Times New Roman",serif; mso-fareast-font-family: "Times New Roman"'&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="TEXT-ALIGN: center; MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal" align=center&gt;&lt;SPAN&gt;&lt;STRONG&gt;Duration:&amp;nbsp;24&lt;/STRONG&gt;&lt;SPAN style='FONT-SIZE: 12pt; FONT-FAMILY: "Times New Roman",serif; mso-fareast-font-family: "Times New Roman"'&gt;&lt;STRONG&gt; Hours (6 hours prepositioned for combat see Designer's Notes)&lt;/STRONG&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="TEXT-ALIGN: center; MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal" align=center&gt;&lt;FONT face=Calibri&gt;&lt;B&gt;&lt;I&gt;&lt;U&gt;&lt;SPAN style='FONT-SIZE: 12pt; COLOR: red; mso-ascii-font-family: Calibri; mso-fareast-font-family: "Times New Roman"; mso-hansi-font-family: Calibri; mso-bidi-font-family: "Times New Roman"'&gt;This is a fairly large scenario it&amp;nbsp;may move slowly at times&lt;/SPAN&gt;&lt;/U&gt;&lt;/I&gt;&lt;/B&gt;&lt;SPAN style='FONT-SIZE: 12pt; FONT-FAMILY: "Times New Roman",serif; mso-fareast-font-family: "Times New Roman"'&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="TEXT-ALIGN: center; MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal" align=center&gt;&lt;FONT face=Calibri&gt;&lt;B&gt;&lt;SPAN style='FONT-SIZE: 12pt; COLOR: red; mso-ascii-font-family: Calibri; mso-fareast-font-family: "Times New Roman"; mso-hansi-font-family: Calibri; mso-bidi-font-family: "Times New Roman"'&gt;To avoid lock ups while saving&lt;/SPAN&gt;&lt;/B&gt;&lt;SPAN style='FONT-SIZE: 12pt; FONT-FAMILY: "Times New Roman",serif; mso-fareast-font-family: "Times New Roman"'&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="TEXT-ALIGN: center; MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal" align=center&gt;&lt;FONT face=Calibri&gt;&lt;B&gt;&lt;SPAN style='FONT-SIZE: 12pt; COLOR: red; mso-ascii-font-family: Calibri; mso-fareast-font-family: "Times New Roman"; mso-hansi-font-family: Calibri; mso-bidi-font-family: "Times New Roman"'&gt;1. Hit the space bar to pause&lt;/SPAN&gt;&lt;/B&gt;&lt;SPAN style='FONT-SIZE: 12pt; FONT-FAMILY: "Times New Roman",serif; mso-fareast-font-family: "Times New Roman"'&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="TEXT-ALIGN: center; MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal" align=center&gt;&lt;FONT face=Calibri&gt;&lt;B&gt;&lt;SPAN style='FONT-SIZE: 12pt; COLOR: red; mso-ascii-font-family: Calibri; mso-fareast-font-family: "Times New Roman"; mso-hansi-font-family: Calibri; mso-bidi-font-family: "Times New Roman"'&gt;2. Alt + S to save&lt;/SPAN&gt;&lt;/B&gt;&lt;SPAN style='FONT-SIZE: 12pt; FONT-FAMILY: "Times New Roman",serif; mso-fareast-font-family: "Times New Roman"'&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="TEXT-ALIGN: center; MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal" align=center&gt;&lt;FONT face=Calibri&gt;&lt;B&gt;&lt;SPAN style='FONT-SIZE: 12pt; COLOR: red; mso-ascii-font-family: Calibri; mso-fareast-font-family: "Times New Roman"; mso-hansi-font-family: Calibri; mso-bidi-font-family: "Times New Roman"'&gt;3. Hit the space bar to restart play&lt;/SPAN&gt;&lt;/B&gt;&lt;SPAN style='FONT-SIZE: 12pt; FONT-FAMILY: "Times New Roman",serif; mso-fareast-font-family: "Times New Roman"'&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="TEXT-ALIGN: center; MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal" align=center&gt;&lt;FONT face=Calibri&gt;&lt;B&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-ascii-font-family: Calibri; mso-fareast-font-family: "Times New Roman"; mso-hansi-font-family: Calibri; mso-bidi-font-family: "Times New Roman"'&gt;HAPPY MAY DAY! &lt;/SPAN&gt;&lt;/B&gt;&lt;SPAN style='FONT-SIZE: 12pt; FONT-FAMILY: "Times New Roman",serif; mso-fareast-font-family: "Times New Roman"'&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal"&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-ascii-font-family: Calibri; mso-fareast-font-family: "Times New Roman"; mso-hansi-font-family: Calibri; mso-bidi-font-family: "Times New Roman"'&gt;&lt;FONT face=Calibri&gt;&lt;STRONG&gt;Initial notes:&lt;/STRONG&gt; I tend to design scenarios with what I think is possible in the real world and "game play" as a secondary consideration. I tend to look at scenarios as studies of what might have happened/could happen, based on what was available/could be available. It is possible to score negative points and still be winning if I my assessment is that force might have been largely destroyed but still accounted themselves well in the process. So scenario force balance is a secondary consideration when I design (sorry war isn't always balanced). So if you don't like this and this may not be a scenario for you, conversely if you want to explore what a real world American-Russian confrontation near Syria might be like... 
&lt;P class=MsoNormal style="MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal"&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-ascii-font-family: Calibri; mso-fareast-font-family: "Times New Roman"; mso-hansi-font-family: Calibri; mso-bidi-font-family: "Times New Roman"'&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-ascii-font-family: Calibri; mso-fareast-font-family: "Times New Roman"; mso-hansi-font-family: Calibri; mso-bidi-font-family: "Times New Roman"'&gt;&lt;FONT face=Calibri&gt;&lt;STRONG&gt;Scenario:&lt;/STRONG&gt; The Russian cyber-attack on the Baltic States on Saturday, April 20&lt;SUP&gt;th&lt;/SUP&gt; succeeded far beyond all expectations! Within hours the banking systems of Estonia, Latvia and Lithuania completely collapsed as did much of the power grid and governmental functions. On Sunday, the attack spread to telecommunications and a general denial of service attack on the internet system itself.&lt;SPAN style="mso-spacerun: yes"&gt;&amp;nbsp; &lt;/SPAN&gt;As the attacks occurred over the weekend people generally took them in stride treating the disruptions as a holiday, but on Monday when the majority of people tried to return to work chaos reigned. Street lights and street cars wouldn’t function, commercial transactions were impossible and the eastern portion of each country reminded in the dark.&lt;SPAN style="mso-spacerun: yes"&gt;&amp;nbsp; &lt;/SPAN&gt;By evening, the mood had turned bitter with young people lingering in the streets and public parks. &lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal"&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-ascii-font-family: Calibri; mso-fareast-font-family: "Times New Roman"; mso-hansi-font-family: Calibri; mso-bidi-font-family: "Times New Roman"'&gt;&lt;FONT face=Calibri&gt;On Tuesday the 23&lt;SUP&gt;rd&lt;/SUP&gt; violent disturbances broke out in Navra, Tartu and Rezekne with young Russian men clashing with police. As the crisis entered its fifth day the Prime Minister of Latvia was shot and killed by an assassin while visiting the town of Balvi. On Thursday full scale food riots had broken out across all three countries and, blaming Russia, fighting between ethnic Russians and Latvians became intense in the eastern portion of the country. Up until this point Russian President Vladimr Putun had been very silent on the Baltic developments, but now he called for “Volunteers” to aide their beleaguered and oppressed fellow Russians.&lt;SPAN style="mso-spacerun: yes"&gt;&amp;nbsp; &lt;/SPAN&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal"&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-ascii-font-family: Calibri; mso-fareast-font-family: "Times New Roman"; mso-hansi-font-family: Calibri; mso-bidi-font-family: "Times New Roman"'&gt;&lt;FONT face=Calibri&gt;As chaos continued to descend upon the Baltic all three jointly invoked NATO Article Five asking Brussels for aide. Debate raged in NATO General Council over the weekend until it was proven on Monday that “Little Green Men” were appearing more and more often in the growing civil unrest. Late that day NATO authorized support for the Baltic Republics and that evening a British Tornado air strike destroyed a convoy of “volunteers” crossing the Russian border near Luta, Estonia. Tuesday became a free for all over the skies of the Baltics with NATO and Russian Jets mixing it up over the border area and several NATO aircraft were downed by Russian SA-400 missile sites. To date the crisis had been confined to the Baltics and Baltic Sea but at 18:00 UTC a French satellite pass noted the Russian SSBNs getting underway from the Kola Peninsula and other satellite passes confirmed the rest of the Northern Fleet was getting ready to stand up…&lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal"&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-ascii-font-family: Calibri; mso-fareast-font-family: "Times New Roman"; mso-hansi-font-family: Calibri; mso-bidi-font-family: "Times New Roman"'&gt;&lt;FONT face=Calibri&gt;This scenario is the second in a series and moves the action to the eastern &lt;SPAN style="mso-bidi-font-weight: bold"&gt;Mediterranean Sea&lt;/SPAN&gt;. It is a large and complex scenario that assumes…&lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoListParagraphCxSpFirst style="MARGIN: 0in 0in 0pt 39pt; LINE-HEIGHT: normal; TEXT-INDENT: -21pt; mso-add-space: auto; mso-list: l0 level1 lfo1"&gt;&lt;SPAN style="FONT-SIZE: 12pt; mso-ascii-font-family: Calibri; mso-fareast-font-family: Calibri; mso-hansi-font-family: Calibri; mso-bidi-font-family: Calibri; mso-bidi-font-style: italic"&gt;&lt;SPAN style="mso-list: Ignore"&gt;&lt;FONT face=Calibri&gt;1.&lt;/FONT&gt;&lt;SPAN style='FONT: 7pt "Times New Roman"'&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-ascii-font-family: Calibri; mso-fareast-font-family: "Times New Roman"; mso-hansi-font-family: Calibri; mso-bidi-font-family: "Times New Roman"'&gt;&lt;FONT face=Calibri&gt;An American Carrier Strike Group (CSG) centered on the nuclear carrier USS Eisenhower CVN-69 has been ordered to destroy the Russian position in the eastern Med and Syria including the facilities at Khmeinen Air Field and the expanding naval station at Tartus&lt;SPAN style="mso-bidi-font-style: italic"&gt;. The advance of the Eisenhower CVG is known to Russian Naval Intelligence and has been passed down to Russian military forces in and near Syria. &lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoListParagraphCxSpMiddle style="MARGIN: 0in 0in 0pt 39pt; LINE-HEIGHT: normal; mso-add-space: auto"&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-ascii-font-family: Calibri; mso-fareast-font-family: "Times New Roman"; mso-hansi-font-family: Calibri; mso-bidi-font-family: "Times New Roman"; mso-bidi-font-style: italic'&gt;&lt;o:p&gt;&lt;FONT face=Calibri&gt;&amp;nbsp;&lt;/FONT&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoListParagraphCxSpMiddle style="MARGIN: 0in 0in 0pt 39pt; LINE-HEIGHT: normal; TEXT-INDENT: -21pt; mso-add-space: auto; mso-list: l0 level1 lfo1"&gt;&lt;SPAN style="FONT-SIZE: 12pt; mso-ascii-font-family: Calibri; mso-fareast-font-family: Calibri; mso-hansi-font-family: Calibri; mso-bidi-font-family: Calibri; mso-bidi-font-style: italic"&gt;&lt;SPAN style="mso-list: Ignore"&gt;&lt;FONT face=Calibri&gt;2.&lt;/FONT&gt;&lt;SPAN style='FONT: 7pt "Times New Roman"'&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;FONT face=Calibri&gt;&lt;SPAN lang=EN style='FONT-SIZE: 12pt; mso-ascii-font-family: Calibri; mso-fareast-font-family: "Times New Roman"; mso-hansi-font-family: Calibri; mso-bidi-font-family: "Times New Roman"; mso-ansi-language: EN'&gt;The 619&lt;SUP&gt;th&lt;/SUP&gt; Guards SAM Battalion has been deployed with 8 Transporter Erector Launchers (TEL) and reinforced with an SA-22 Battery. Above ground bunkers recently constructed are likely reloads for the batteries. This is also well known to NATO intel, open source intel and has been extensively discussed on a message board for and American company’s wargame called “&lt;B style="mso-bidi-font-weight: normal"&gt;&lt;I style="mso-bidi-font-style: normal"&gt;Command&lt;/I&gt;&lt;/B&gt;!”&lt;/SPAN&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-ascii-font-family: Calibri; mso-fareast-font-family: "Times New Roman"; mso-hansi-font-family: Calibri; mso-bidi-font-family: "Times New Roman"; mso-bidi-font-style: italic'&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/P&gt;
&lt;P class=MsoListParagraphCxSpMiddle style="MARGIN: 0in 0in 0pt 0.5in"&gt;&lt;SPAN lang=EN style='FONT-SIZE: 12pt; LINE-HEIGHT: 107%; mso-ascii-font-family: Calibri; mso-fareast-font-family: "Times New Roman"; mso-hansi-font-family: Calibri; mso-bidi-font-family: "Times New Roman"; mso-ansi-language: EN'&gt;&lt;o:p&gt;&lt;FONT face=Calibri&gt;&amp;nbsp;&lt;/FONT&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoListParagraphCxSpMiddle style="MARGIN: 0in 0in 0pt 39pt; LINE-HEIGHT: normal; TEXT-INDENT: -21pt; mso-add-space: auto; mso-list: l0 level1 lfo1"&gt;&lt;SPAN style="FONT-SIZE: 12pt; mso-ascii-font-family: Calibri; mso-fareast-font-family: Calibri; mso-hansi-font-family: Calibri; mso-bidi-font-family: Calibri; mso-bidi-font-style: italic"&gt;&lt;SPAN style="mso-list: Ignore"&gt;&lt;FONT face=Calibri&gt;3.&lt;/FONT&gt;&lt;SPAN style='FONT: 7pt "Times New Roman"'&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;FONT face=Calibri&gt;&lt;SPAN lang=EN style='FONT-SIZE: 12pt; mso-ascii-font-family: Calibri; mso-fareast-font-family: "Times New Roman"; mso-hansi-font-family: Calibri; mso-bidi-font-family: "Times New Roman"; mso-ansi-language: EN'&gt;Turkey has declared neutrality and renounced participation in Article Five of the NATO General Articles. American facilities on Incerlik Air Base have been blockaded and American aircraft will be allowed to fly out in ferry mode with drop tanks only. American stores on the base have been seized by Turkish paratroopers. Turkey is in a state of armed neutrality and several Turkish submarines and surface vessels have left port and sailed into both the Black Sea and &lt;/SPAN&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-ascii-font-family: Calibri; mso-fareast-font-family: "Times New Roman"; mso-hansi-font-family: Calibri; mso-bidi-font-family: "Times New Roman"; mso-bidi-font-weight: bold'&gt;Mediterranean&lt;/SPAN&gt;&lt;SPAN lang=EN style='FONT-SIZE: 12pt; mso-ascii-font-family: Calibri; mso-fareast-font-family: "Times New Roman"; mso-hansi-font-family: Calibri; mso-bidi-font-family: "Times New Roman"; mso-ansi-language: EN'&gt;.&lt;/SPAN&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-ascii-font-family: Calibri; mso-fareast-font-family: "Times New Roman"; mso-hansi-font-family: Calibri; mso-bidi-font-family: "Times New Roman"; mso-bidi-font-style: italic'&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/P&gt;
&lt;P class=MsoListParagraphCxSpMiddle style="MARGIN: 0in 0in 0pt 0.5in"&gt;&lt;SPAN style='FONT-SIZE: 12pt; LINE-HEIGHT: 107%; mso-ascii-font-family: Calibri; mso-fareast-font-family: "Times New Roman"; mso-hansi-font-family: Calibri; mso-bidi-font-family: "Times New Roman"; mso-bidi-font-style: italic'&gt;&lt;o:p&gt;&lt;FONT face=Calibri&gt;&amp;nbsp;&lt;/FONT&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoListParagraphCxSpMiddle style="MARGIN: 0in 0in 0pt 39pt; LINE-HEIGHT: normal; TEXT-INDENT: -21pt; mso-add-space: auto; mso-list: l0 level1 lfo1"&gt;&lt;SPAN style="FONT-SIZE: 12pt; mso-ascii-font-family: Calibri; mso-fareast-font-family: Calibri; mso-hansi-font-family: Calibri; mso-bidi-font-family: Calibri; mso-bidi-font-style: italic"&gt;&lt;SPAN style="mso-list: Ignore"&gt;&lt;FONT face=Calibri&gt;4.&lt;/FONT&gt;&lt;SPAN style='FONT: 7pt "Times New Roman"'&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-ascii-font-family: Calibri; mso-fareast-font-family: "Times New Roman"; mso-hansi-font-family: Calibri; mso-bidi-font-family: "Times New Roman"; mso-bidi-font-style: italic'&gt;&lt;FONT face=Calibri&gt;Israel has remained neutral in the conflict but tensions are high between Iranian backed Hezbollah militants and Syrian forces. IDF air and naval forces are actively patrolling off Lebanon and Syria.&lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoListParagraphCxSpMiddle style="MARGIN: 0in 0in 0pt 0.5in"&gt;&lt;SPAN style='FONT-SIZE: 12pt; LINE-HEIGHT: 107%; mso-ascii-font-family: Calibri; mso-fareast-font-family: "Times New Roman"; mso-hansi-font-family: Calibri; mso-bidi-font-family: "Times New Roman"; mso-bidi-font-style: italic'&gt;&lt;o:p&gt;&lt;FONT face=Calibri&gt;&amp;nbsp;&lt;/FONT&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoListParagraphCxSpMiddle style="MARGIN: 0in 0in 0pt 39pt; LINE-HEIGHT: normal; TEXT-INDENT: -21pt; mso-add-space: auto; mso-list: l0 level1 lfo1"&gt;&lt;SPAN style="FONT-SIZE: 12pt; mso-ascii-font-family: Calibri; mso-fareast-font-family: Calibri; mso-hansi-font-family: Calibri; mso-bidi-font-family: Calibri; mso-bidi-font-style: italic"&gt;&lt;SPAN style="mso-list: Ignore"&gt;&lt;FONT face=Calibri&gt;5.&lt;/FONT&gt;&lt;SPAN style='FONT: 7pt "Times New Roman"'&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-ascii-font-family: Calibri; mso-fareast-font-family: "Times New Roman"; mso-hansi-font-family: Calibri; mso-bidi-font-family: "Times New Roman"; mso-bidi-font-style: italic'&gt;&lt;FONT face=Calibri&gt;A small subset of normal shipping and commercial air traffic is in the area and they WILL get in the way of belligerents. Do not engage civilian traffic!&lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoListParagraphCxSpMiddle style="MARGIN: 0in 0in 0pt 0.5in"&gt;&lt;SPAN lang=EN style='FONT-SIZE: 12pt; LINE-HEIGHT: 107%; mso-ascii-font-family: Calibri; mso-fareast-font-family: "Times New Roman"; mso-hansi-font-family: Calibri; mso-bidi-font-family: "Times New Roman"; mso-ansi-language: EN'&gt;&lt;o:p&gt;&lt;FONT face=Calibri&gt;&amp;nbsp;&lt;/FONT&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoListParagraphCxSpLast style="MARGIN: 0in 0in 0pt 39pt; LINE-HEIGHT: normal; TEXT-INDENT: -21pt; mso-add-space: auto; mso-list: l0 level1 lfo1"&gt;&lt;SPAN style="FONT-SIZE: 12pt; mso-ascii-font-family: Calibri; mso-fareast-font-family: Calibri; mso-hansi-font-family: Calibri; mso-bidi-font-family: Calibri; mso-bidi-font-style: italic"&gt;&lt;SPAN style="mso-list: Ignore"&gt;&lt;FONT face=Calibri&gt;6.&lt;/FONT&gt;&lt;SPAN style='FONT: 7pt "Times New Roman"'&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;FONT face=Calibri&gt;&lt;SPAN lang=EN style='FONT-SIZE: 12pt; mso-ascii-font-family: Calibri; mso-fareast-font-family: "Times New Roman"; mso-hansi-font-family: Calibri; mso-bidi-font-family: "Times New Roman"; mso-ansi-language: EN'&gt;I have not released nuclear weapons, I find them very uninteresting and frightening. The rational for #8 above is my hope that as we moved closer to their use sanity will have prevailed.&lt;/SPAN&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-ascii-font-family: Calibri; mso-fareast-font-family: "Times New Roman"; mso-hansi-font-family: Calibri; mso-bidi-font-family: "Times New Roman"; mso-bidi-font-style: italic'&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 0pt 0.5in; LINE-HEIGHT: normal; TEXT-INDENT: -0.25in"&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-ascii-font-family: Calibri; mso-fareast-font-family: "Times New Roman"; mso-hansi-font-family: Calibri; mso-bidi-font-family: "Times New Roman"'&gt;&lt;o:p&gt;&lt;FONT face=Calibri&gt;&amp;nbsp;&lt;/FONT&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal"&gt;&lt;SPAN lang=EN style='FONT-SIZE: 12pt; mso-ascii-font-family: Calibri; mso-fareast-font-family: "Times New Roman"; mso-hansi-font-family: Calibri; mso-bidi-font-family: "Times New Roman"; mso-ansi-language: EN'&gt;&lt;FONT face=Calibri&gt;I do hope you enjoy it!&lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal"&gt;&lt;FONT face=Calibri&gt;&lt;B style="mso-bidi-font-weight: normal"&gt;&lt;SPAN lang=EN style='FONT-SIZE: 12pt; mso-ascii-font-family: Calibri; mso-fareast-font-family: "Times New Roman"; mso-hansi-font-family: Calibri; mso-bidi-font-family: "Times New Roman"; mso-ansi-language: EN'&gt;Designer’s notes:&lt;/SPAN&gt;&lt;/B&gt;&lt;SPAN lang=EN style='FONT-SIZE: 12pt; mso-ascii-font-family: Calibri; mso-fareast-font-family: "Times New Roman"; mso-hansi-font-family: Calibri; mso-bidi-font-family: "Times New Roman"; mso-ansi-language: EN'&gt; This is part two of the Arctic Tsunami scenario and begins simultaneously as that scenario, so Russian maritime patrol aircraft are engaged in the north and couldn’t transit neutral Turkey anyway. What this scenario comes down to is a chess match between an American Carrier Strike Group (CSG) and the Russian SA-400 system. I say chess match because my play testing has shown you really need to be thinking several moves ahead and really coordinating your efforts on both sides. In play testing I have both lost miserably and achieved Triumphs. In one recent playtest I left the Eisenhower as a dead and burning hulk at the conclusion and in a second sank her, so, YES, you CAN win as the Russians (but admittedly it takes a lot of luck)! The real target in Syria are the naval facilities at Tartus, that is the political target that will really hurt Putin! &lt;/SPAN&gt;&lt;/FONT&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal"&gt;&lt;SPAN lang=EN style='FONT-SIZE: 12pt; mso-ascii-font-family: Calibri; mso-fareast-font-family: "Times New Roman"; mso-hansi-font-family: Calibri; mso-bidi-font-family: "Times New Roman"; mso-ansi-language: EN'&gt;&lt;FONT face=Calibri&gt;I deliberately did not place exclusion zones over Turkey or other “Neutrals” as borders are a nebulous thing in this part of the world. &lt;SPAN style="mso-spacerun: yes"&gt;&amp;nbsp;I also left the NATO missions I designed for the NATO patrols as I figure not all players want to recreate their own and for those who do it's not a burdon for them to delete the current missions. You will have to create your own strike missions as the NATO player. I also positioned the CSG/CVBG well west of Cyprus and at least 6 hours from expected contact (30/22:00 Zulu) so the players had the time to change load outs in the scenario if they desire and do not have to change them in the scenario editor.&lt;BR&gt;&lt;BR&gt;&lt;/SPAN&gt;The neutrals took me two weeks, of my spare time, to build and are real vessels and aircraft flight paths are taken from both AIS Marine Traffic and FlightAware. Destroying neutrals will punish both sides as world opinion will go against both belligerents for loss of innocent life. Also be aware there are non-belligerent warships in the area as well, so make sure you know what you are shooting at. Given the Fog of War and not knowing who actually destroyed a non-belligerent vessel will result in both sides loosing points. I’m sure as some point, if the war didn’t escalate to nukes, the tapes and displays would be reviewed to see who sank a non-belligerent warship but in the scenario timeframe, no one is going to have the time. That judgement will be for future history, &lt;B style="mso-bidi-font-weight: normal"&gt;&lt;I style="mso-bidi-font-style: normal"&gt;if any&lt;/I&gt;&lt;/B&gt;…&lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal"&gt;&lt;FONT face=Calibri&gt;&lt;SPAN lang=EN style='FONT-SIZE: 12pt; mso-ascii-font-family: Calibri; mso-fareast-font-family: "Times New Roman"; mso-hansi-font-family: Calibri; mso-bidi-font-family: "Times New Roman"; mso-ansi-language: EN'&gt;CONSTRUCTIVE COMMENTS FOR IMPROVEMENT ARE APPRECIATED!&lt;/SPAN&gt;&lt;SPAN style='FONT-SIZE: 12pt; FONT-FAMILY: "Times New Roman",serif; mso-fareast-font-family: "Times New Roman"'&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal"&gt;&lt;FONT face=Calibri&gt;&lt;B&gt;&lt;SPAN lang=EN style='FONT-SIZE: 12pt; mso-ascii-font-family: Calibri; mso-fareast-font-family: "Times New Roman"; mso-hansi-font-family: Calibri; mso-bidi-font-family: "Times New Roman"; mso-ansi-language: EN'&gt;Created Under Version v1.13 -&amp;nbsp;Build 972.11&lt;/SPAN&gt;&lt;/B&gt;&lt;/FONT&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal"&gt;&lt;FONT face=Calibri&gt;&lt;B&gt;&lt;SPAN lang=EN style='FONT-SIZE: 12pt; mso-ascii-font-family: Calibri; mso-fareast-font-family: "Times New Roman"; mso-hansi-font-family: Calibri; mso-bidi-font-family: "Times New Roman"; mso-ansi-language: EN'&gt;Last Revision 5/3/2019 Version 1.15 - Build 1009.27.6&lt;/SPAN&gt;&lt;/B&gt;&lt;/FONT&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal"&gt;&lt;FONT face=Calibri&gt;&lt;B&gt;&lt;SPAN lang=EN style='FONT-SIZE: 12pt; mso-ascii-font-family: Calibri; mso-fareast-font-family: "Times New Roman"; mso-hansi-font-family: Calibri; mso-bidi-font-family: "Times New Roman"; mso-ansi-language: EN'&gt;A .INI and Delta File are provided for rebuilds.&lt;/SPAN&gt;&lt;/B&gt;&lt;/FONT&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal"&gt;&lt;SPAN lang=EN style='FONT-SIZE: 12pt; mso-ascii-font-family: Calibri; mso-fareast-font-family: "Times New Roman"; mso-hansi-font-family: Calibri; mso-bidi-font-family: "Times New Roman"; mso-ansi-language: EN'&gt;&lt;FONT face=Calibri&gt;Al “BeirutDude” Sandrik (ex-Beachinnole)&lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal"&gt;&lt;SPAN lang=EN style='FONT-SIZE: 12pt; mso-ascii-font-family: Calibri; mso-fareast-font-family: "Times New Roman"; mso-hansi-font-family: Calibri; mso-bidi-font-family: "Times New Roman"; mso-ansi-language: EN'&gt;&lt;FONT face=Calibri&gt;&lt;A href="mailto:Al.sandrik@gmail.com"&gt;Al.sandrik@gmail.com&lt;/A&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;&lt;/BODY&gt;</ScenDescription>
