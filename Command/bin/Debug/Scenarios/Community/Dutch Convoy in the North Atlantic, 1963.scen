<?xml version="1.0"?>
<ScenContainer xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <ScenTitle>Dutch Convoy in the North Atlantic, 1963</ScenTitle>
  <ScenDescription>&lt;BODY scroll=auto&gt;&lt;P&gt;&lt;FONT size=4&gt;This scenario assumes that hostilities between the Soviet Union and NATO broke out during the late Spring of 1963.&lt;/FONT&gt;&lt;/P&gt;
&lt;P&gt;&lt;FONT size=4&gt;You are in command of a Dutch convoy currently en route to the United States to pick up replenishments for NATO forces.&amp;nbsp; You mission is quite simple--get as many of your ships to Boston as posssible.&amp;nbsp; Sink any Soviet ships or submarines that get in your way.&lt;/FONT&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in"&gt;&lt;SPAN style="FONT-SIZE: 14pt"&gt;-------------------------------------------------------&lt;?xml:namespace prefix = "o" ns = "urn:schemas-microsoft-com:office:office" /&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P&gt;&lt;SPAN style="FONT-SIZE: 14pt"&gt;A delta template .ini file has been included in the .zip file to assist in updating the scenario to any future versions of the database.&amp;nbsp; &lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in"&gt;&lt;SPAN style="FONT-SIZE: 14pt"&gt;Scenario Author: Mark Gellis&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in"&gt;&lt;o:p&gt;&amp;nbsp;&lt;/o:p&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in"&gt;&lt;o:p&gt;&amp;nbsp;&lt;/o:p&gt;&lt;/P&gt;
&lt;P&gt;&lt;/P&gt;&lt;/BODY&gt;</ScenDescription>
