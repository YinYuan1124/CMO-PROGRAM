<?xml version="1.0"?>
<ScenContainer xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <ScenTitle>Smart Bracelet, 2014</ScenTitle>
  <ScenDescription>&lt;BODY scroll=auto&gt;&lt;P&gt;&lt;FONT size=4&gt;This scenario assumes that Mexico is dealing with a drug cartel based in Guatemala.&amp;nbsp; The cartel has been smuggling both drugs and weapons into Mexico.&amp;nbsp; The Mexican government is determined to stop these criminal activities.&lt;/FONT&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 0pt"&gt;&lt;SPAN style="FONT-SIZE: 14pt"&gt;-------------------------------------------------------&lt;?xml:namespace prefix = "o" ns = "urn:schemas-microsoft-com:office:office" /&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&lt;SPAN style="FONT-SIZE: 14pt"&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 0pt; TEXT-AUTOSPACE: ideograph-numeric; mso-layout-grid-align: auto; punctuation-wrap: hanging; mso-vertical-align-alt: auto"&gt;&lt;FONT size=4&gt;Boardings can be modeled in Command by matching course and speed&amp;nbsp;with&amp;nbsp;the target vessel, closing to within a few hundred yards of that vessel, and remaining there for a sufficient amount of time.&lt;SPAN style="mso-spacerun: yes"&gt;&amp;nbsp; &lt;/SPAN&gt;You will receive a message if your inspection or boarding is successful.&amp;nbsp;&lt;/FONT&gt;&lt;/P&gt;
&lt;P&gt;A delta template .ini file has been included in the .zip file to assist in updating the scenario to any future versions of the database.&amp;nbsp; &lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 0pt"&gt;&lt;SPAN style="FONT-SIZE: 14pt"&gt;Scenario Author: Mark Gellis&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P&gt;&lt;/P&gt;&lt;/BODY&gt;</ScenDescription>
  <Complexity>1</Complexity>
  <Difficulty>2</Difficulty>
