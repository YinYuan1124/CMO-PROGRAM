<?xml version="1.0"?>
<ScenContainer xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <ScenTitle>Operation Journeyman, 1977</ScenTitle>
  <ScenDescription>&lt;BODY scroll=auto&gt;&lt;P class=MsoNormal style="MARGIN: 0cm 0cm 0pt"&gt;&lt;B style="mso-bidi-font-weight: normal"&gt;&lt;SPAN lang=EN-GB style="FONT-SIZE: 13.5pt; mso-ansi-language: EN-GB"&gt;Argentina&amp;nbsp;vs. Britain&lt;/SPAN&gt;&lt;/B&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0cm 0cm 0pt"&gt;&lt;SPAN lang=EN-GB style="mso-ansi-language: EN-GB"&gt;&lt;?xml:namespace prefix = "o" ns = "urn:schemas-microsoft-com:office:office" /&gt;&lt;o:p&gt;&amp;nbsp;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0cm 0cm 0pt"&gt;&lt;SPAN&gt;&lt;STRONG&gt;Date/Time:&amp;nbsp;&lt;/STRONG&gt;25th November, 1977 / 22:00:00 Zulu&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0cm 0cm 0pt"&gt;&lt;STRONG&gt;&lt;SPAN lang=EN-GB style="mso-ansi-language: EN-GB"&gt;Location: &lt;/SPAN&gt;&lt;/STRONG&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0cm 0cm 0pt"&gt;&lt;SPAN lang=EN-GB style="mso-ansi-language: EN-GB"&gt;&lt;STRONG&gt;Playable Sides: &lt;/STRONG&gt;Argentina&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0cm 0cm 0pt"&gt;&lt;SPAN lang=EN-GB style="mso-ansi-language: EN-GB"&gt;&lt;/SPAN&gt;&amp;nbsp;&lt;/P&gt;&lt;SPAN lang=EN-GB style="mso-ansi-language: EN-GB"&gt;
&lt;P&gt;&lt;B&gt;Operation Journeyman&lt;/B&gt; was a Royal Navy&amp;nbsp;operation&amp;nbsp;sending a naval group&amp;nbsp;(including 1 SSN, 2 frigates and 2 auxiliary ships) to the South Atlantic in reaction to the creation of a base with 50 scientists on Southern Thule. Later a military base on Thule was set up by the Argentinians.&lt;/P&gt;
&lt;P&gt;The action was stopped by diplomatic means.&lt;/P&gt;
&lt;P&gt;What if the Royal Navy was ordered to attack the Argentinian base?&lt;/P&gt;
&lt;P&gt;Author: Miguel Molina 'Meroka37'&lt;/P&gt;
&lt;P&gt;&amp;nbsp;&lt;/P&gt;
&lt;P&gt;&amp;nbsp;&lt;/P&gt;&lt;/SPAN&gt;&lt;/BODY&gt;</ScenDescription>
