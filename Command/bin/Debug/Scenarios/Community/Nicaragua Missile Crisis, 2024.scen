<?xml version="1.0"?>
<ScenContainer xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <ScenTitle>Nicaragua Missile Crisis, 2024</ScenTitle>
  <ScenDescription>&lt;BODY scroll=auto&gt;&lt;P align=center&gt;&amp;nbsp;&lt;SPAN style='FONT-SIZE: 12pt; mso-fareast-font-family: "Times New Roman"; mso-bidi-font-family: Calibri; mso-bidi-theme-font: minor-latin'&gt;&lt;FONT face=Calibri&gt;&lt;STRONG&gt;Nicaragua Missile Crisis, 2024&lt;?xml:namespace prefix = "o" ns = "urn:schemas-microsoft-com:office:office" /&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/STRONG&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="TEXT-ALIGN: center; MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal; mso-margin-top-alt: auto; mso-margin-bottom-alt: auto" align=center&gt;&lt;FONT face=Calibri&gt;&lt;STRONG&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-fareast-font-family: "Times New Roman"; mso-bidi-font-family: Calibri; mso-bidi-theme-font: minor-latin'&gt;Al "Beirutdude" Sandrik&lt;/SPAN&gt;&lt;SPAN style='FONT-SIZE: 12pt; FONT-FAMILY: "Times New Roman",serif; mso-fareast-font-family: "Times New Roman"'&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/STRONG&gt;&lt;/FONT&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="TEXT-ALIGN: center; MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal; mso-margin-top-alt: auto; mso-margin-bottom-alt: auto" align=center&gt;&lt;FONT face=Calibri&gt;&lt;STRONG&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-fareast-font-family: "Times New Roman"; mso-bidi-font-family: Calibri; mso-bidi-theme-font: minor-latin'&gt;The Time Is: 30 October, 2024, 00:00 Zulu / &lt;/SPAN&gt;&lt;SPAN style='FONT-SIZE: 12pt; FONT-FAMILY: "Times New Roman",serif; mso-fareast-font-family: "Times New Roman"'&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/STRONG&gt;&lt;/FONT&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="TEXT-ALIGN: center; MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal; mso-margin-top-alt: auto; mso-margin-bottom-alt: auto" align=center&gt;&lt;FONT face=Calibri&gt;&lt;STRONG&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-fareast-font-family: "Times New Roman"; mso-bidi-font-family: Calibri; mso-bidi-theme-font: minor-latin'&gt;29 October 2024 18:00 Nicaragua Time&lt;/SPAN&gt;&lt;SPAN style='FONT-SIZE: 12pt; FONT-FAMILY: "Times New Roman",serif; mso-fareast-font-family: "Times New Roman"'&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/STRONG&gt;&lt;/FONT&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="TEXT-ALIGN: center; MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal; mso-margin-top-alt: auto; mso-margin-bottom-alt: auto" align=center&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-fareast-font-family: "Times New Roman"; mso-bidi-font-family: Calibri; mso-bidi-theme-font: minor-latin'&gt;&lt;FONT face=Calibri&gt;&lt;STRONG&gt;Playable as the United States Only&lt;o:p&gt;&lt;/o:p&gt;&lt;/STRONG&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="TEXT-ALIGN: center; MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal; mso-margin-top-alt: auto; mso-margin-bottom-alt: auto" align=center&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-fareast-font-family: "Times New Roman"; mso-bidi-font-family: Calibri; mso-bidi-theme-font: minor-latin'&gt;&lt;FONT face=Calibri&gt;&lt;STRONG&gt;3 Days Duration&lt;/STRONG&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="TEXT-ALIGN: center; MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal; mso-margin-top-alt: auto; mso-margin-bottom-alt: auto" align=center&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-fareast-font-family: "Times New Roman"; mso-bidi-font-family: Calibri; mso-bidi-theme-font: minor-latin'&gt;&lt;FONT face=Calibri&gt;&lt;STRONG&gt;Special thanks to Knighthawk75 for his help with Lua coding&lt;/STRONG&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&amp;nbsp;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal; mso-margin-top-alt: auto; mso-margin-bottom-alt: auto"&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-fareast-font-family: "Times New Roman"; mso-bidi-font-family: Calibri; mso-bidi-theme-font: minor-latin'&gt;&lt;FONT face=Calibri&gt;&lt;STRONG&gt;Background:&lt;/STRONG&gt; Daniel Ortega the, once and future, dictator of Nicaragua won the 2021 election handily and quickly assumed full power dissolving the last vestiges of democracy in the country. Ortega rapidly strengthened his ties with the People’s Republic of China (PRC), accepting arms/training and signing agreements to host People’s Liberation Army (PLA) air bases and port facilities. The deals weren’t all one sided however, soon the people of Nicaragua were&amp;nbsp;realizing a lifestyle that few of them had ever dared dream of with new jobs and modern consumer goods flooding the country. By early 2024 the two new&amp;nbsp;(2) PLA Air Force (PLA(AF)) air bases were ready as well as an expanded port facility capable of supporting submarines and large cargo operations. The PLA also built an Integrated Air Defense System (IADS) across the northern portion of the country to defend those bases. &lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal; mso-margin-top-alt: auto; mso-margin-bottom-alt: auto"&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-fareast-font-family: "Times New Roman"; mso-bidi-font-family: Calibri; mso-bidi-theme-font: minor-latin'&gt;&lt;FONT face=Calibri&gt;&lt;o:p&gt;Daniel Ortega was busy in the world of International affairs, as he cozied up to Russian President Putin and Venezuelan President Mudero obtaining much needed arms and energy transfers from them as well! &lt;/o:p&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal; mso-margin-top-alt: auto; mso-margin-bottom-alt: auto"&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-fareast-font-family: "Times New Roman"; mso-bidi-font-family: Calibri; mso-bidi-theme-font: minor-latin'&gt;&lt;FONT face=Calibri&gt;All of this was closely monitored by the United States, and in late September an unusual convoy departed the PRC with two (2) Ro-Ro vessels with unusually large ramps headed for Nicaragua. When they arrived, they disgorged between 12 to 24 Transport Erector Launches (TELs) with, what analysists believed were, nuclear capable missiles on them. By late October these TELs were dispersed in central Nicaragua with the United States demanding their removal. The clock had been turned back about 50 years and the United States faced yet another “Missile Crisis!”&lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal; mso-margin-top-alt: auto; mso-margin-bottom-alt: auto"&gt;&lt;FONT face=Calibri&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-fareast-font-family: "Times New Roman"; mso-bidi-font-family: Calibri; mso-bidi-theme-font: minor-latin'&gt;&lt;STRONG&gt;Mission: &lt;/STRONG&gt;Your mission is to...&lt;/SPAN&gt;&lt;SPAN style='FONT-SIZE: 12pt; FONT-FAMILY: "Times New Roman",serif; mso-fareast-font-family: "Times New Roman"'&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal; mso-margin-top-alt: auto; mso-margin-bottom-alt: auto"&gt;&lt;FONT face=Calibri&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-fareast-font-family: "Times New Roman"; mso-bidi-font-family: Calibri; mso-bidi-theme-font: minor-latin'&gt;1.&amp;nbsp;Destroy the 12 to 24 TELs,&amp;nbsp;&lt;/SPAN&gt;&lt;SPAN style='FONT-SIZE: 12pt; FONT-FAMILY: "Times New Roman",serif; mso-fareast-font-family: "Times New Roman"'&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal; mso-margin-top-alt: auto; mso-margin-bottom-alt: auto"&gt;&lt;FONT face=Calibri&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-fareast-font-family: "Times New Roman"; mso-bidi-font-family: Calibri; mso-bidi-theme-font: minor-latin'&gt;2. Degrade the PLA(AF) and PLA IADS positions, &lt;/SPAN&gt;&lt;SPAN style='FONT-SIZE: 12pt; FONT-FAMILY: "Times New Roman",serif; mso-fareast-font-family: "Times New Roman"'&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal; mso-margin-top-alt: auto; mso-margin-bottom-alt: auto"&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-fareast-font-family: "Times New Roman"; mso-bidi-font-family: Calibri; mso-bidi-theme-font: minor-latin'&gt;&lt;FONT face=Calibri&gt;3. Damage destroy the two PLA(AF) airbases and the port facilities. &lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal; mso-margin-top-alt: auto; mso-margin-bottom-alt: auto"&gt;&lt;FONT face=Calibri&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-fareast-font-family: "Times New Roman"; mso-bidi-font-family: Calibri; mso-bidi-theme-font: minor-latin'&gt;4.&amp;nbsp;Destroy&amp;nbsp;any PLA(N) submarines encountered.&lt;/SPAN&gt;&lt;SPAN style='FONT-SIZE: 12pt; FONT-FAMILY: "Times New Roman",serif; mso-fareast-font-family: "Times New Roman"'&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal; mso-margin-top-alt: auto; mso-margin-bottom-alt: auto"&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-fareast-font-family: "Times New Roman"; mso-bidi-font-family: Calibri; mso-bidi-theme-font: minor-latin'&gt;&lt;FONT face=Calibri&gt;You will have elements of the USAF and USN at your disposal. Allowing a nuclear weapon to detonate in the southern United States will have dire consequences for your victory chances. &lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal; mso-margin-top-alt: auto; mso-margin-bottom-alt: auto"&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-fareast-font-family: "Times New Roman"; mso-bidi-font-family: Calibri; mso-bidi-theme-font: minor-latin'&gt;&lt;FONT face=Calibri&gt;&lt;STRONG&gt;Scenario Notes: &lt;o:p&gt;&lt;/o:p&gt;&lt;/STRONG&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal; mso-margin-top-alt: auto; mso-margin-bottom-alt: auto"&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-fareast-font-family: "Times New Roman"; mso-bidi-font-family: Calibri; mso-bidi-theme-font: minor-latin'&gt;&lt;FONT face=Calibri&gt;&lt;STRONG&gt;General:&lt;o:p&gt;&lt;/o:p&gt;&lt;/STRONG&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal; mso-margin-top-alt: auto; mso-margin-bottom-alt: auto"&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-fareast-font-family: "Times New Roman"; mso-bidi-font-family: Calibri; mso-bidi-theme-font: minor-latin'&gt;&lt;FONT face=Calibri&gt;Please ensure that Popup Messages are enabled. This scenario relies heavily on pop up messages. Emergency Action Messages (EAMs) will come across to you with information about the world situation and scenario hints/vital information. &lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal; mso-margin-top-alt: auto; mso-margin-bottom-alt: auto"&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-fareast-font-family: "Times New Roman"; mso-bidi-font-family: Calibri; mso-bidi-theme-font: minor-latin'&gt;&lt;FONT face=Calibri&gt;Please do not delete any locked Reference Points (RPs), they are necessary for events to function properly. &lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal; mso-margin-top-alt: auto; mso-margin-bottom-alt: auto"&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-fareast-font-family: "Times New Roman"; mso-bidi-font-family: Calibri; mso-bidi-theme-font: minor-latin'&gt;&lt;FONT face=Calibri&gt;There are three “Sides”/sets of facilities in the CONtinental United States (CONUS), “CONUS Aimpoints,” which are Neutral to you to help you differentiate them, Command Aircraft, which are friendly to you and your “United States” facilities. Aimpoints are just what they sound like, civilian and military aimpoints for People’s Liberation Army (Rocket Forces) (PLA(RF)) missiles/nukes to attack. Sorry things get crowded over the southern U.S. but it was the best way to use Single Unit Airfields/Ports and still have something the PLA(RF) could target. Many “aimpoints” are oil refineries, shipyards and other critical infrastructure liable to be “nuked.” I have grouped aimpoints were possible.&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal; mso-margin-top-alt: auto; mso-margin-bottom-alt: auto"&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-fareast-font-family: "Times New Roman"; mso-bidi-font-family: Calibri; mso-bidi-theme-font: minor-latin'&gt;&lt;FONT face=Calibri&gt;Mexico, Belize, El Salvador and Honduras have allowed overflights for both aircraft and weapons, and Mexico has allowed limited basing rights for drone aircraft. Cuba is a no Navigation Zone.&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal; mso-margin-top-alt: auto; mso-margin-bottom-alt: auto"&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-fareast-font-family: "Times New Roman"; mso-bidi-font-family: Calibri; mso-bidi-theme-font: minor-latin'&gt;&lt;FONT face=Calibri&gt;Nicaragua and the PRC begin the scenario “neutral” to you. They are not really neutral, but rather are at a more “weapons tight” condition of readiness which can ratchet up to Unfriendly before going over to Hostile. So, it just allows for&amp;nbsp;an additional level of developing tension before the firing begins. &lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal; mso-margin-top-alt: auto; mso-margin-bottom-alt: auto"&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-fareast-font-family: "Times New Roman"; mso-bidi-font-family: Calibri; mso-bidi-theme-font: minor-latin'&gt;&lt;FONT face=Calibri&gt;When you violate Nicaraguan Airspace, Nicaraguan forces will become hostile to you and are fair game for combat. You do not receive&amp;nbsp;any VPs for destroying Nicaraguan bases, radars and aircraft. &lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal; mso-margin-top-alt: auto; mso-margin-bottom-alt: auto"&gt;&lt;FONT face=Calibri&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-fareast-font-family: "Times New Roman"; mso-bidi-font-family: Calibri; mso-bidi-theme-font: minor-latin'&gt;There may be a period of time before the PLA(RF) Transporter Erector Launcher (TEL)s are ready to launch their weapons. Each unit represents an individual TEL (not two/four as in the database).&lt;/SPAN&gt;&lt;SPAN style='FONT-SIZE: 12pt; FONT-FAMILY: "Times New Roman",serif; mso-fareast-font-family: "Times New Roman"'&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal; mso-margin-top-alt: auto; mso-margin-bottom-alt: auto"&gt;&lt;FONT face=Calibri&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-fareast-font-family: "Times New Roman"; mso-bidi-font-family: Calibri; mso-bidi-theme-font: minor-latin'&gt;While THAAD batteries are mentioned in the messages and briefings, they are not present in the scenario, they were somewhat redundant were removed to improve computer performance. This is also why there are no merchant ships or&amp;nbsp;civilian aircraft as well.&amp;nbsp;&lt;/SPAN&gt;&lt;SPAN style='FONT-SIZE: 12pt; FONT-FAMILY: "Times New Roman",serif; mso-fareast-font-family: "Times New Roman"'&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal; mso-margin-top-alt: auto; mso-margin-bottom-alt: auto"&gt;&lt;FONT face=Calibri&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-fareast-font-family: "Times New Roman"; mso-bidi-font-family: Calibri; mso-bidi-theme-font: minor-latin'&gt;The scenario is designed to be played in rapid (fire symbol) time for, at least, the first 21 hours as you ready your aircraft. There is a 260 nm No Navigation Zone around Nicaragua which will be removed when you are authorized to launch conventional strikes with the conclusion of the President’s ultimatum (2024-10-31, 00:00:00 UTC/Zulu). Combat can begin before then (over the Caribbean for example) but your aircraft can not approach the Nicaraguan bases until after the ultimatum.&amp;nbsp; This is in line with the PRC's 250 nm Total Exclusion Zone (TEZ) which will turn the PRC "Hostile" when it is violated.&lt;/SPAN&gt;&lt;SPAN style='FONT-SIZE: 12pt; FONT-FAMILY: "Times New Roman",serif; mso-fareast-font-family: "Times New Roman"'&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal; mso-margin-top-alt: auto; mso-margin-bottom-alt: auto"&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-fareast-font-family: "Times New Roman"; mso-bidi-font-family: Calibri; mso-bidi-theme-font: minor-latin'&gt;&lt;FONT face=Calibri&gt;&lt;STRONG&gt;&lt;FONT color=red&gt;House rule:&lt;/FONT&gt;&lt;/STRONG&gt; Relative to the above, POTUS desires any rounds fired prior to the expiration of his ultimatum be fired first by Nicaragua or the PRC, not the U.S. The U.S. may not attack anywhere in Nicaragua until after 2024-10-31, 00:00:00 UTC/Zulu. Obviously with extended range munitions I can’t enforce this.&lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal; mso-margin-top-alt: auto; mso-margin-bottom-alt: auto"&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-fareast-font-family: "Times New Roman"; mso-bidi-font-family: Calibri; mso-bidi-theme-font: minor-latin'&gt;&lt;FONT face=Calibri&gt;Initially the use of nuclear weapons is not allowed (weapons tight), if circumstances dictate POTUS will release nuclear weapons for use in Nicaragua.&lt;SPAN style="mso-spacerun: yes"&gt;&amp;nbsp; &lt;/SPAN&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal; mso-margin-top-alt: auto; mso-margin-bottom-alt: auto"&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-fareast-font-family: "Times New Roman"; mso-bidi-font-family: Calibri; mso-bidi-theme-font: minor-latin'&gt;&lt;FONT face=Calibri&gt;&lt;STRONG&gt;Aircraft:&lt;o:p&gt;&lt;/o:p&gt;&lt;/STRONG&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal; mso-margin-top-alt: auto; mso-margin-bottom-alt: auto"&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-fareast-font-family: "Times New Roman"; mso-bidi-font-family: Calibri; mso-bidi-theme-font: minor-latin'&gt;&lt;FONT face=Calibri&gt;There are several aircraft missions set, delete them if you wish. It’s your game delete or adjust them if you don’t like them. The “Ferry” missions are just to disperse the E-3Gs to more southern airfields. I could have done&amp;nbsp;so in the set up but decided it would be a bit interesting and more realistic to disperse some during the opening moves of the sceanrio. This is part of the staging of assets to the Gulf/Southern States.&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal; mso-margin-top-alt: auto; mso-margin-bottom-alt: auto"&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-fareast-font-family: "Times New Roman"; mso-bidi-font-family: Calibri; mso-bidi-theme-font: minor-latin'&gt;&lt;FONT face=Calibri&gt;Only “support/tanker” and “nuclear alert” aircraft have been readied. Many of the aircraft I have set to “Reserve” with delayed ready times (longer than normal for a particular loadout). You have 24 hours before the President’s ultimatum expires and combat is likely. You really should try to avoid combat until the President’s ultimatum expires and then hit PLA (and by default Nicaraguan) forces in Nicaragua hard as soon as it does. &lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal; mso-margin-top-alt: auto; mso-margin-bottom-alt: auto"&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-fareast-font-family: "Times New Roman"; mso-bidi-font-family: Calibri; mso-bidi-theme-font: minor-latin'&gt;&lt;FONT face=Calibri&gt;The Carrier Air Wings (CAW) on the two carriers are composite wings. Most of the squadrons are the actual squadrons assigned to the Carrier Strike Groups (CSG)&amp;nbsp;&lt;STRONG&gt;&lt;FONT color=red&gt;BUT&lt;/FONT&gt;&lt;/STRONG&gt; where possible I have substituted an F-35C squadron where they were available (east or west coast respectively). &lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal; mso-margin-top-alt: auto; mso-margin-bottom-alt: auto"&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-fareast-font-family: "Times New Roman"; mso-bidi-font-family: Calibri; mso-bidi-theme-font: minor-latin'&gt;&lt;/SPAN&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-fareast-font-family: "Times New Roman"; mso-bidi-font-family: Calibri; mso-bidi-theme-font: minor-latin'&gt;&lt;FONT face=Calibri&gt;Every aircraft was tested with a random number generator and depending upon the aircraft type, had a 30 or 40 percent chance of being in “Maintenance” status. Aircraft in maintenance at shore stations have been removed so they don’t slow down the game. That is why some aircraft are out of numbering sequence and squadrons are not at their allotted number of aircraft. Aircraft in maintenance status on ships remain as they take up flight/hangar deck space.&lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal; mso-margin-top-alt: auto; mso-margin-bottom-alt: auto"&gt;&lt;FONT face=Calibri&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-fareast-font-family: "Times New Roman"; mso-bidi-font-family: Calibri; mso-bidi-theme-font: minor-latin'&gt;Some aircraft have been staging to the southern CONUS for days before the start of the scenario (for example USAF F-35As are at NAS Corpus Christi, TX and NAS Kingsville, TX. Also EC-130H aircraft staged to Dallas/Fort Worth ad Cecil Airport, Jacksonville, FL). &lt;/SPAN&gt;&lt;SPAN style='FONT-SIZE: 12pt; FONT-FAMILY: "Times New Roman",serif; mso-fareast-font-family: "Times New Roman"'&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal; mso-margin-top-alt: auto; mso-margin-bottom-alt: auto"&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-fareast-font-family: "Times New Roman"; mso-bidi-font-family: Calibri; mso-bidi-theme-font: minor-latin'&gt;&lt;FONT face=Calibri&gt;The F-15Cs readied at Homestead Reserve AFB are “Coil Det.” 159th FS FL ANG/North American Air Defense and thus are “on alert.”&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal; mso-margin-top-alt: auto; mso-margin-bottom-alt: auto"&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-fareast-font-family: "Times New Roman"; mso-bidi-font-family: Calibri; mso-bidi-theme-font: minor-latin'&gt;&lt;FONT face=Calibri&gt;JATMs at Tyndall AFB are some of the first arriving operational JATMS, and Tyndall is schedued to begin flight ops again in 2022-23.&lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal; mso-margin-top-alt: auto; mso-margin-bottom-alt: auto"&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-fareast-font-family: "Times New Roman"; mso-bidi-font-family: Calibri; mso-bidi-theme-font: minor-latin'&gt;&lt;FONT face=Calibri&gt;&lt;STRONG&gt;Vessels:&lt;o:p&gt;&lt;/o:p&gt;&lt;/STRONG&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal; mso-margin-top-alt: auto; mso-margin-bottom-alt: auto"&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-fareast-font-family: "Times New Roman"; mso-bidi-font-family: Calibri; mso-bidi-theme-font: minor-latin'&gt;&lt;FONT face=Calibri&gt;Ships/TFs in the Gulf of Mexico (three of them) and the SSNs all teleport within their mission OPAREAs. The teleport event is set to occur 5 seconds into the game. So, if you decide you want to delete their missions, then please run the game until the Teleport&amp;nbsp;occurs. None of the missions activate until 10 seconds into the game so you can adjust the waypoints as you see fit either before or after the teleport, but they are necessary for the vessels to sucessfully teleport.&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal; mso-margin-top-alt: auto; mso-margin-bottom-alt: auto"&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-fareast-font-family: "Times New Roman"; mso-bidi-font-family: Calibri; mso-bidi-theme-font: minor-latin'&gt;&lt;FONT face=Calibri&gt;Just an FYI, I had an Ohio Trident SSBN in the scenario, with the Trident MIRVs&amp;nbsp;it made it a very short scenario if nukes flew. Thus, I took it out. Nukes on the B-52Hs and B-2As make it short enough at that point. &lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal; mso-margin-top-alt: auto; mso-margin-bottom-alt: auto"&gt;&lt;FONT face=Calibri&gt;&lt;STRONG&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-fareast-font-family: "Times New Roman"; mso-bidi-font-family: Calibri; mso-bidi-theme-font: minor-latin'&gt;Scoring: -20,000 points = Disaster and 40,000 a Triumph&lt;/SPAN&gt;&lt;SPAN style='FONT-SIZE: 12pt; FONT-FAMILY: "MS Mincho"; mso-bidi-font-family: Calibri; mso-bidi-theme-font: minor-latin; mso-ascii-font-family: Calibri; mso-ascii-theme-font: minor-latin; mso-hansi-font-family: Calibri; mso-hansi-theme-font: minor-latin'&gt;　&lt;/SPAN&gt;&lt;SPAN style='FONT-SIZE: 12pt; FONT-FAMILY: "Times New Roman",serif; mso-fareast-font-family: "Times New Roman"'&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/STRONG&gt;&lt;/FONT&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal; mso-margin-top-alt: auto; mso-margin-bottom-alt: auto"&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-fareast-font-family: "Times New Roman"; mso-bidi-font-family: Calibri; mso-bidi-theme-font: minor-latin'&gt;&lt;FONT face=Calibri&gt;&lt;STRONG&gt;Built under C:MO Build 1147.30 Database DB3000 v487&lt;o:p&gt;&lt;/o:p&gt;&lt;/STRONG&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal; mso-margin-top-alt: auto; mso-margin-bottom-alt: auto"&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-fareast-font-family: "Times New Roman"; mso-bidi-font-family: Calibri; mso-bidi-theme-font: minor-latin'&gt;&lt;FONT face=Calibri&gt;&lt;STRONG&gt;A Delta .INI File is provided for deep rebuilds.&lt;o:p&gt;&lt;/o:p&gt;&lt;/STRONG&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal; mso-margin-top-alt: auto; mso-margin-bottom-alt: auto"&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-fareast-font-family: "Times New Roman"; mso-bidi-font-family: Calibri; mso-bidi-theme-font: minor-latin'&gt;&lt;FONT face=Calibri&gt;&lt;STRONG&gt;Al "BeirutDude" Sandrik (ex-Beachinnole)&lt;o:p&gt;&lt;/o:p&gt;&lt;/STRONG&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal; mso-margin-top-alt: auto; mso-margin-bottom-alt: auto"&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-fareast-font-family: "Times New Roman"; mso-bidi-font-family: Calibri; mso-bidi-theme-font: minor-latin'&gt;&lt;FONT face=Calibri&gt;&lt;A href="mailto:Al.Sandrik@gmail.com"&gt;&lt;STRONG&gt;Al.Sandrik@gmail.com&lt;/STRONG&gt;&lt;/A&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;&lt;/BODY&gt;</ScenDescription>
