<?xml version="1.0"?>
<ScenContainer xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <ScenTitle>En Garde, 2013</ScenTitle>
  <ScenDescription>&lt;BODY scroll=auto&gt;&lt;P&gt;&lt;SPAN lang=EN-GB style="mso-ansi-language: EN-GB"&gt;&lt;STRONG&gt;&lt;/STRONG&gt;&lt;/SPAN&gt;&amp;nbsp;Date: 4th July 2.013 05:00:00 Z&lt;/P&gt;
&lt;P&gt;&amp;nbsp;Sides: France vs United Kingdom&lt;/P&gt;
&lt;P&gt;&amp;nbsp;Sides playable : France&lt;/P&gt;
&lt;P&gt;
&lt;P&gt;&lt;SPAN lang=EN-GB style="mso-ansi-language: EN-GB"&gt;&lt;STRONG&gt;Exercise “EN GARDE 2013” is held this year in North Atlantic Waters. The purpose o this exercise is to evaluate the capabilities of a French task force against the land defences of another nation. This time the defender will be &lt;?xml:namespace prefix = "st1" ns = "urn:schemas-microsoft-com:office:smarttags" /&gt;&lt;st1:place w:st="on"&gt;&lt;st1:country-region w:st="on"&gt;United Kingdom&lt;/st1:country-region&gt;&lt;/st1:place&gt;.&lt;?xml:namespace prefix = "o" ns = "urn:schemas-microsoft-com:office:office" /&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/STRONG&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P&gt;&lt;SPAN lang=EN-GB style="mso-ansi-language: EN-GB"&gt;&lt;STRONG&gt;Defence will include RAF units (fighters, AEW assets and tankers), Royal Navy units and Royal Artillery, besides a wide net of early warning radars across the &lt;st1:place w:st="on"&gt;Island&lt;/st1:place&gt;.&lt;o:p&gt;&lt;/o:p&gt;&lt;/STRONG&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P&gt;
&lt;P&gt;&amp;nbsp;&lt;/P&gt;
&lt;P&gt;Author: PdL Design Team&amp;nbsp; (David Perez, Miguel Molina)&lt;/P&gt;
&lt;P&gt;&amp;nbsp;&lt;/P&gt;
&lt;P&gt;&lt;IMG style="HEIGHT: 377px; WIDTH: 567px" alt=http://webarchive.nationalarchives.gov.uk/+/http://www.operations.mod.uk/t200/images/t200fr50.jpg src="http://webarchive.nationalarchives.gov.uk/+/http://www.operations.mod.uk/t200/images/t200fr50.jpg" width=799 align=middle height=560&gt;&lt;/P&gt;
&lt;P&gt;&amp;nbsp;&lt;/P&gt;
&lt;P&gt;&amp;nbsp;&lt;/P&gt;
&lt;P&gt;&lt;/P&gt;
&lt;P&gt;&lt;/P&gt;&lt;/BODY&gt;</ScenDescription>
