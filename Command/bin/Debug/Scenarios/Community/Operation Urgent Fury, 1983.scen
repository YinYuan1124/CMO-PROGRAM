<?xml version="1.0"?>
<ScenContainer xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <ScenTitle>Operation Urgent Fury, 1983</ScenTitle>
  <ScenDescription>&lt;BODY text=#dcdcdc bgColor=#2b2b2b scroll=auto&gt;&lt;P class=MsoNormal style="TEXT-ALIGN: center; MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal; mso-margin-top-alt: auto; mso-margin-bottom-alt: auto" align=center&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-fareast-font-family: "Times New Roman"; mso-bidi-font-family: Calibri; mso-bidi-theme-font: minor-latin'&gt;&lt;FONT face=Calibri&gt;&lt;FONT color=white&gt;&lt;STRONG&gt;Operation Urgent Fury, 1983&lt;?xml:namespace prefix = "o" ns = "urn:schemas-microsoft-com:office:office" /&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/STRONG&gt;&lt;/FONT&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="TEXT-ALIGN: center; MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal; mso-margin-top-alt: auto; mso-margin-bottom-alt: auto" align=center&gt;&lt;FONT face=Calibri&gt;&lt;FONT color=white&gt;&lt;STRONG&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-fareast-font-family: "Times New Roman"; mso-bidi-font-family: Calibri; mso-bidi-theme-font: minor-latin'&gt;Al "Beirutdude" Sandrik&lt;/SPAN&gt;&lt;SPAN style='FONT-SIZE: 12pt; FONT-FAMILY: "Times New Roman",serif; mso-fareast-font-family: "Times New Roman"'&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/STRONG&gt;&lt;/FONT&gt;&lt;/FONT&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="TEXT-ALIGN: center; MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal; mso-margin-top-alt: auto; mso-margin-bottom-alt: auto" align=center&gt;&lt;FONT face=Calibri&gt;&lt;FONT color=white&gt;&lt;STRONG&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-fareast-font-family: "Times New Roman"; mso-bidi-font-family: Calibri; mso-bidi-theme-font: minor-latin'&gt;The Time Is: 25 October, 1983, 02:00 Zulu / &lt;/SPAN&gt;&lt;SPAN style='FONT-SIZE: 12pt; FONT-FAMILY: "Times New Roman",serif; mso-fareast-font-family: "Times New Roman"'&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/STRONG&gt;&lt;/FONT&gt;&lt;/FONT&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="TEXT-ALIGN: center; MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal; mso-margin-top-alt: auto; mso-margin-bottom-alt: auto" align=center&gt;&lt;FONT face=Calibri&gt;&lt;FONT color=white&gt;&lt;STRONG&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-fareast-font-family: "Times New Roman"; mso-bidi-font-family: Calibri; mso-bidi-theme-font: minor-latin'&gt;24 October 2024 21:00 Grenada Time&lt;/SPAN&gt;&lt;SPAN style='FONT-SIZE: 12pt; FONT-FAMILY: "Times New Roman",serif; mso-fareast-font-family: "Times New Roman"'&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/STRONG&gt;&lt;/FONT&gt;&lt;/FONT&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="TEXT-ALIGN: center; MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal; mso-margin-top-alt: auto; mso-margin-bottom-alt: auto" align=center&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-fareast-font-family: "Times New Roman"; mso-bidi-font-family: Calibri; mso-bidi-theme-font: minor-latin'&gt;&lt;FONT face=Calibri&gt;&lt;FONT color=white&gt;&lt;STRONG&gt;Playable as the United States Only&lt;o:p&gt;&lt;/o:p&gt;&lt;/STRONG&gt;&lt;/FONT&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="TEXT-ALIGN: center; MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal; mso-margin-top-alt: auto; mso-margin-bottom-alt: auto" align=center&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-fareast-font-family: "Times New Roman"; mso-bidi-font-family: Calibri; mso-bidi-theme-font: minor-latin'&gt;&lt;FONT face=Calibri&gt;&lt;FONT color=white&gt;&lt;STRONG&gt;2 Days Duration &lt;o:p&gt;&lt;/o:p&gt;&lt;/STRONG&gt;&lt;/FONT&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="TEXT-ALIGN: center; MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal; mso-margin-top-alt: auto; mso-margin-bottom-alt: auto" align=center&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-fareast-font-family: "Times New Roman"; mso-bidi-font-family: Calibri; mso-bidi-theme-font: minor-latin'&gt;&lt;FONT face=Calibri&gt;&lt;FONT color=white&gt;&lt;STRONG&gt;This Scenario uses Cargo Missions&lt;/STRONG&gt;&lt;/FONT&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="TEXT-ALIGN: center; MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal; mso-margin-top-alt: auto; mso-margin-bottom-alt: auto" align=center&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-fareast-font-family: "Times New Roman"; mso-bidi-font-family: Calibri; mso-bidi-theme-font: minor-latin'&gt;&lt;FONT color=red face=Calibri&gt;&lt;STRONG&gt;Due to limitations in C:MO there are just some issues with Urgent Fury/Grenada 1983 that just can't be fully or adequately covered. Most of those are listed in the Notes section. I think this catches the "Spirit" of Urgent Fury but it NOT an exact recreation of the actual operation.&lt;/STRONG&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal; mso-margin-top-alt: auto; mso-margin-bottom-alt: auto"&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-fareast-font-family: "Times New Roman"; mso-bidi-font-family: Calibri; mso-bidi-theme-font: minor-latin'&gt;&lt;FONT face=Calibri&gt;&lt;FONT color=white&gt;&lt;STRONG&gt;Background: &lt;/STRONG&gt;&lt;SPAN style="mso-spacerun: yes"&gt;&amp;nbsp;&lt;/SPAN&gt;In mid-October, 1983 the island of Grenada was in chaos with at least 19 soldiers and civilians killed in a confrontation on 19 October. The dead included the deposed Prime Minister, Maurice Bishop, his partner, Jacqueline Creft, two cabinet ministers and two union leaders. General Hudson Austin, of the People’s Revolutionary Army (PRA) of Grenada, seized power and declared a four-day ‘shoot on sight” curfew across the island. Long a bone of contention for the Reagan Administration was the expansion of the Point Salines International Airport in the southern portion of the island. &lt;SPAN style="mso-spacerun: yes"&gt;&amp;nbsp;&lt;/SPAN&gt;Despite the fact that the project was proposed and funded with the help of Britain, Canada, Cuba, Libya, Algeria, and other nations, the Administration pointed to the construction by Cuban nationals as a clear sign of nefarious intentions. With the shoot on sight curfew order Hudson gave the United States it’s rational for invasion, the rescue of some 600 medical students on the island…&lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal; mso-margin-top-alt: auto; mso-margin-bottom-alt: auto"&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-fareast-font-family: "Times New Roman"; mso-bidi-font-family: Calibri; mso-bidi-theme-font: minor-latin'&gt;&lt;FONT face=Calibri&gt;&lt;FONT color=white&gt;&lt;STRONG&gt;Mission:&lt;/STRONG&gt; Your mission is to seize important landmarks on the island starting with the Point Salines and Pearls Airports and rescue Governor-General Sir Paul Scoon from the island while destroying the PRA and Cuban forces. &lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal; mso-margin-top-alt: auto; mso-margin-bottom-alt: auto"&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-fareast-font-family: "Times New Roman"; mso-bidi-font-family: Calibri; mso-bidi-theme-font: minor-latin'&gt;&lt;FONT face=Calibri&gt;&lt;FONT color=white&gt;&lt;STRONG&gt;Scenario Notes: &lt;o:p&gt;&lt;/o:p&gt;&lt;/STRONG&gt;&lt;/FONT&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal; mso-margin-top-alt: auto; mso-margin-bottom-alt: auto"&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-fareast-font-family: "Times New Roman"; mso-bidi-font-family: Calibri; mso-bidi-theme-font: minor-latin'&gt;&lt;FONT face=Calibri&gt;&lt;FONT color=white&gt;You must activate a special action (Lightning bolt on tool bar) to activate C/SAR to Rescue Sir Paul Scoon (I suggest just before extraction). Rescuing him is worth 500 Victory Points (VPs)! SEAL Teams 2 (conjectured number) and Seal Team 6 should be inserted at the same time as the rescue. Once the SEAL Team insertions are done, I suggest you repurpose their aircraft to other uses.&lt;/FONT&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal; mso-margin-top-alt: auto; mso-margin-bottom-alt: auto"&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-fareast-font-family: "Times New Roman"; mso-bidi-font-family: Calibri; mso-bidi-theme-font: minor-latin'&gt;&lt;FONT face=Calibri&gt;&lt;FONT color=white&gt;The PRA and Cuban forces are more numerous than in reality and the U.S./Caribbean Forces less numerous. C:MO is not a ground game and the Cubans/PRA could not dig in (or take any advantage of terrain). So, to try to cover the spirit of the action this was my solution. It is not an exact replay of Urgent Fury in that regard and &lt;STRONG&gt;&lt;EM&gt;&lt;U&gt;you will "win" before the historical outcome&lt;/U&gt;&lt;/EM&gt;&lt;/STRONG&gt;. &lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal; mso-margin-top-alt: auto; mso-margin-bottom-alt: auto"&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-fareast-font-family: "Times New Roman"; mso-bidi-font-family: Calibri; mso-bidi-theme-font: minor-latin'&gt;&lt;FONT face=Calibri&gt;&lt;FONT color=white&gt;The 106th SOAR helicopters are on Barbados. Why? C:MO cargo ops are a bit clunky and this was my compromise for some major Lua coding to simulate bringing helicopters in by C-141B. Ferry them to Point Salinas Airport when it is taken to help ferry troops around the island.&lt;/FONT&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal; mso-margin-top-alt: auto; mso-margin-bottom-alt: auto"&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-fareast-font-family: "Times New Roman"; mso-bidi-font-family: Calibri; mso-bidi-theme-font: minor-latin'&gt;&lt;FONT face=Calibri&gt;&lt;FONT color=white&gt;The American 75th Rangers are at Hunter Army Airfield (AAF), Savannah, Georgia and the 82nd Airborne at Pope AFB, North Carolina. The AC-130s on Barbados? Well, it seemed pointless to have you fly them from Hurlburt Field, Florida (you’re welcome). All Air National Guard A-7Ds are in Puerto Rico for the same reasons (again your welcome).&amp;nbsp; I suggest you&amp;nbsp;rebase the C-130Hs to the bases in PR enroute to Point Salinas Airport to avoid an RTB before the airdrops. The Combat Talons can be aerially refueled.&lt;/FONT&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal; mso-margin-top-alt: auto; mso-margin-bottom-alt: auto"&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-fareast-font-family: "Times New Roman"; mso-bidi-font-family: Calibri; mso-bidi-theme-font: minor-latin'&gt;&lt;FONT face=Calibri&gt;&lt;FONT color=white&gt;Cargo Ops don’t allow you to ferry troops on the island (airport to airport) and generate the units on arrival. Once again rather than add a LOT of Lua coding to generate units for &lt;EM&gt;&lt;STRONG&gt;&lt;U&gt;very little difference in the game play&lt;/U&gt;&lt;/STRONG&gt;&lt;/EM&gt; all reinforcements paradrop onto the island. You need to load your cargo for cargo ops on PhibRon 4, Hunter and Pope. &lt;/FONT&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal; mso-margin-top-alt: auto; mso-margin-bottom-alt: auto"&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-fareast-font-family: "Times New Roman"; mso-bidi-font-family: Calibri; mso-bidi-theme-font: minor-latin'&gt;&lt;FONT face=Calibri&gt;&lt;FONT color=white&gt;Amphibious operations: HISTORIALLY PhibRon4 backloaded some units (can't do that for boat units in C:MO) and entered the Caribbean to land troops/tanks&amp;nbsp;for ops&amp;nbsp;near Government House. You don't have to land them, just an option in the scenario.&lt;/FONT&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal; mso-margin-top-alt: auto; mso-margin-bottom-alt: auto"&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-fareast-font-family: "Times New Roman"; mso-bidi-font-family: Calibri; mso-bidi-theme-font: minor-latin'&gt;&lt;FONT face=Calibri&gt;&lt;FONT color=white&gt;American Close Air Support (CAS) played a role, especially AC-130s and USAF/USN A-7Ds, but they weren’t everywhere like they could have been. Thus, I spread out the available CAS as much as possible. You need to choose your loadouts for your CAS aircraft. A-10s and KC-135s are at Roosevelt roads NS, Puerto Rico. CAS will still be too effective in this scenario as the PRA/Cubans can't dig in!&lt;/FONT&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal; mso-margin-top-alt: auto; mso-margin-bottom-alt: auto"&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-fareast-font-family: "Times New Roman"; mso-bidi-font-family: Calibri; mso-bidi-theme-font: minor-latin'&gt;&lt;FONT face=Calibri&gt;&lt;FONT color=white&gt;There are a lot of locked Reference Points (RPs) please don’t delete them, they are necessary for awarding VPs and transferring control of the facilities. &lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal; mso-margin-top-alt: auto; mso-margin-bottom-alt: auto"&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-fareast-font-family: "Times New Roman"; mso-bidi-font-family: Calibri; mso-bidi-theme-font: minor-latin'&gt;&lt;FONT face=Calibri&gt;&lt;FONT color=white&gt;I set up some cargo, and other missions, to give the player a head start, delete them if you want, but I suggest you leave the “Snatch N Grab” mission for rescuing Sir Paul Scoon intact. Once you activate the C/SAR in Special Actions you can pick him up.&lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal; mso-margin-top-alt: auto; mso-margin-bottom-alt: auto"&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-fareast-font-family: "Times New Roman"; mso-bidi-font-family: Calibri; mso-bidi-theme-font: minor-latin'&gt;&lt;FONT face=Calibri&gt;&lt;FONT color=white&gt;Units must occupy any infrastructure area for two (2) hours to capture it. When you do the infrastructure will come under your control. Two hours simulates clearing snipers, booby traps and cleaning access (such as runways). &lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal; mso-margin-top-alt: auto; mso-margin-bottom-alt: auto"&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-fareast-font-family: "Times New Roman"; mso-bidi-font-family: Calibri; mso-bidi-theme-font: minor-latin'&gt;&lt;FONT face=Calibri&gt;&lt;FONT color=white&gt;I originally had 600 “Civilians” for you to pick up, it was a mess, so I deleted that aspect of the scenario. Capturing their campuses (True Blue, Grand Anse and the Hospital) enables you to rescue them. &lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal; mso-margin-top-alt: auto; mso-margin-bottom-alt: auto"&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-fareast-font-family: "Times New Roman"; mso-bidi-font-family: Calibri; mso-bidi-theme-font: minor-latin'&gt;&lt;FONT face=Calibri&gt;&lt;FONT color=white&gt;PRA BTR-60s and BRDM-2s are single vehicles not platoons. &lt;/FONT&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal; mso-margin-top-alt: auto; mso-margin-bottom-alt: auto"&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-fareast-font-family: "Times New Roman"; mso-bidi-font-family: Calibri; mso-bidi-theme-font: minor-latin'&gt;&lt;FONT face=Calibri&gt;&lt;FONT color=white&gt;Fort Matthw and the Mental Hospital are for reference only, you don't need to take any actions with respect to them.&lt;/FONT&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal; mso-margin-top-alt: auto; mso-margin-bottom-alt: auto"&gt;&lt;FONT face=Calibri&gt;&lt;FONT color=white&gt;&lt;STRONG&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-fareast-font-family: "Times New Roman"; mso-bidi-font-family: Calibri; mso-bidi-theme-font: minor-latin'&gt;Scoring: 0 points = Disaster and 4,500 = a Triumph&lt;/SPAN&gt;&lt;SPAN style='FONT-SIZE: 12pt; FONT-FAMILY: "MS Mincho"; mso-bidi-font-family: Calibri; mso-bidi-theme-font: minor-latin; mso-ascii-font-family: Calibri; mso-ascii-theme-font: minor-latin; mso-hansi-font-family: Calibri; mso-hansi-theme-font: minor-latin'&gt;　&lt;/SPAN&gt;&lt;SPAN style='FONT-SIZE: 12pt; FONT-FAMILY: "Times New Roman",serif; mso-fareast-font-family: "Times New Roman"'&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/STRONG&gt;&lt;/FONT&gt;&lt;/FONT&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal; mso-margin-top-alt: auto; mso-margin-bottom-alt: auto"&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-fareast-font-family: "Times New Roman"; mso-bidi-font-family: Calibri; mso-bidi-theme-font: minor-latin'&gt;&lt;FONT face=Calibri&gt;&lt;FONT color=white&gt;&lt;STRONG&gt;Built under C:MO Build 1147.30 Database DB3000 v487&lt;o:p&gt;&lt;/o:p&gt;&lt;/STRONG&gt;&lt;/FONT&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal; mso-margin-top-alt: auto; mso-margin-bottom-alt: auto"&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-fareast-font-family: "Times New Roman"; mso-bidi-font-family: Calibri; mso-bidi-theme-font: minor-latin'&gt;&lt;FONT face=Calibri&gt;&lt;FONT color=white&gt;&lt;STRONG&gt;A Delta .INI File is provided for deep rebuilds.&lt;o:p&gt;&lt;/o:p&gt;&lt;/STRONG&gt;&lt;/FONT&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal; mso-margin-top-alt: auto; mso-margin-bottom-alt: auto"&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-fareast-font-family: "Times New Roman"; mso-bidi-font-family: Calibri; mso-bidi-theme-font: minor-latin'&gt;&lt;FONT face=Calibri&gt;&lt;FONT color=white&gt;&lt;STRONG&gt;Al "BeirutDude" Sandrik (ex-Beachinnole)&lt;o:p&gt;&lt;/o:p&gt;&lt;/STRONG&gt;&lt;/FONT&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal; mso-margin-top-alt: auto; mso-margin-bottom-alt: auto"&gt;&lt;SPAN style='FONT-SIZE: 12pt; mso-fareast-font-family: "Times New Roman"; mso-bidi-font-family: Calibri; mso-bidi-theme-font: minor-latin'&gt;&lt;FONT color=white face=Calibri&gt;&lt;A href="mailto:Al.Sandrik@gmail.com"&gt;Al.Sandrik@gmail.com&lt;/A&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;&lt;/BODY&gt;</ScenDescription>
