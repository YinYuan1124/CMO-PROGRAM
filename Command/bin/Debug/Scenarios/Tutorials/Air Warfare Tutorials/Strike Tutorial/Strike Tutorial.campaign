<?xml version="1.0" encoding="utf-8"?>
<Campaign>
    <ID>e9556b66-1a7d-4768-8311-2cc86d8db16a</ID>
    <Name>Strike Tutorials</Name>
    <Description>&lt;p&gt;&lt;span&gt;&lt;span style="font-family: Calibri;"&gt;&lt;strong&gt;Strike Tutorial&lt;/strong&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span&gt;&lt;span style="font-family: Calibri;"&gt;This is a simple campaign comprising a series of simple tutorials that will take you from the most basic of air attacks to quite advanced methods of using stealth, jamming, SEAD and deception.&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span&gt;&lt;span style="font-family: Calibri;"&gt;By &lt;strong&gt;Gunner98 &lt;/strong&gt;AKA Bart Gauvin&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;</Description>
    <EndingText>&lt;BODY scroll=auto&gt;&lt;SPAN style="mso-ansi-language: EN-CA"&gt;&lt;FONT face=Calibri&gt;
&lt;P class=MsoNormal style="MARGIN: 0cm 0cm 8pt"&gt;&lt;SPAN style="mso-ansi-language: EN-CA"&gt;Congratulations!&lt;?xml:namespace prefix = "o" ns = "urn:schemas-microsoft-com:office:office" /&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0cm 0cm 8pt"&gt;&lt;SPAN style="mso-ansi-language: EN-CA"&gt;You have successfully completed the ‘Strike Tutorial’ campaign.&lt;SPAN style="mso-spacerun: yes"&gt;&amp;nbsp; &lt;/SPAN&gt;Armed with the knowledge you have gained in these tutorials you should be well equipped to tackle a large number of Command Scenarios.&lt;SPAN style="mso-spacerun: yes"&gt;&amp;nbsp; &lt;/SPAN&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0cm 0cm 8pt"&gt;&lt;SPAN style="mso-ansi-language: EN-CA"&gt;You should probably move on to the ‘Basic Training Tutorials’ and ‘Uncle Mark’s Tutorials’ which are stepping stones to many of the fantastic community built scenarios available in the Community Pack, which WarfareSims maintains.&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0cm 0cm 8pt"&gt;&lt;SPAN style="mso-ansi-language: EN-CA"&gt;&lt;o:p&gt;&amp;nbsp;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0cm 0cm 8pt"&gt;&lt;SPAN style="mso-ansi-language: EN-CA"&gt;See you on the Forums &lt;SPAN style="mso-spacerun: yes"&gt;&amp;nbsp;&amp;nbsp;&lt;/SPAN&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0cm 0cm 8pt"&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;SPAN style="mso-ansi-language: EN-CA"&gt;&lt;o:p&gt;&lt;FONT face=Calibri&gt;&amp;nbsp;&lt;/FONT&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;P class=MsoNormal style="MARGIN: 0cm 0cm 8pt"&gt;&lt;SPAN style="mso-ansi-language: EN-CA"&gt;&lt;FONT face=Calibri&gt;By &lt;B style="mso-bidi-font-weight: normal"&gt;Gunner98 &lt;/B&gt;AKA Bart Gauvin&lt;/FONT&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&lt;/BODY&gt;</EndingText>
